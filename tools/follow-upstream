REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
MANIFEST = os.path.join(REPO_ROOT, 'tools', 'follow-upstream.yml')
CACHE_DIR = os.path.join(
    os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')),
    'lfops-follow-upstream',
)
CONTAINER_IMAGE = 'quay.io/rockylinux/rockylinux:9'
CONTAINER_LABEL = 'lfops-follow-upstream'
HEADER_LINES = 10  # the header comment block is searched within the first lines only

# Versions and file names come from the vendor's repository and end up in templates, in
# the output a headless agent reads, and in GitHub issues, so anything unusual is refused.
VERSION_RE = re.compile(r'\d+(?:\.\d+)+')
PATH_RE = re.compile(r'[\w.+@:~/-]+', re.ASCII)
BASED_ON_RE = re.compile(r'Based on (?P<package>\S+) (?P<version>\d+(?:\.\d+)+)\b')
TIMESTAMP_RE = re.compile(r'^(?P<prefix>\W*)(?P<stamp>\d{10})(?P<suffix>\W*)$')
ENV_RE = re.compile(r'\$\{(?P<name>\w+)\}')
# A pre-release marker in the package version or release, matched case-insensitively.
# Also passed to the container scripts, so it has to be a valid POSIX ERE.
PRERELEASE_RE = r'(^|[^a-z])(alpha|beta|dev|pre|preview|rc|snapshot)([^a-z]|$)'
ALLOW_PRERELEASE = False  # set by `--allow-prerelease`

# The bash scripts that run in the podman container, see the comments in the scripts.
CONTAINER_SCRIPTS = os.path.join(REPO_ROOT, 'tools', 'follow-upstream-container')


class FetchError(Exception):
    pass


class MissingEnvError(Exception):
    pass


def expand(value):
    """Replace `${NAME}` by the environment variable, e.g. a repository token.

    Messages show the unexpanded value, so a token never ends up in the output.
    """

    def lookup(match):
        name = match.group('name')
        if name not in os.environ:
            raise MissingEnvError(f'{name} is not set')
        return os.environ[name]

    return ENV_RE.sub(lookup, value)


def version_key(version):
    return [
        int(part) if part.isdigit() else part for part in re.split(r'[.-]', version)
    ]


def series_of(version, parts):
    return '.'.join(version.split('.')[:parts])


def repo_series(config, version):
    """The series in the repository URL, if it differs from the template series.

    Collabora Enterprise has one template per `26.04.4`, but one repository per `26.04`.
    """
    return series_of(version, config.get('repo_series_parts', config['series_parts']))


def series_name(config, series):
    """The series as the templates and `supported_versions` name it: `3.x` for `3`."""
    return series + config.get('series_suffix', '')


def find_app(manifest, name):
    if name in manifest:
        return name, manifest[name]
    for app, config in manifest.items():
        if name in config.get('upstream', []):
            return app, config
    sys.exit(f'{name}: not in {os.path.relpath(MANIFEST, REPO_ROOT)}')


def container_script(name):
    """Return the script `name` of CONTAINER_SCRIPTS, with common.sh in front."""
    text = ''
    for filename in ('common.sh', name):
        with open(os.path.join(CONTAINER_SCRIPTS, filename), encoding='utf-8') as f:
            text += f.read()
    return text


def remove_leftover_containers():
    """Remove stopped containers of an earlier run.

    `--rm` does not happen when a run is killed, and the configuration of such a
    container holds the repository URL, including a token.
    """
    subprocess.run(  # nosec B603 B607 - fixed argument list
        [
            'podman',
            'container',
            'prune',
            '--force',
            '--filter',
            f'label={CONTAINER_LABEL}',
        ],
        stdout=subprocess.DEVNULL,
        check=False,
    )


def run_container(script, env, volume=None):
    # `--env NAME` without a value passes the variable from podman's environment, so a
    # repository token does not show up in the process list (see common.sh for the
    # processes in the container)
    command = ['podman', 'run', '--rm', '--label', CONTAINER_LABEL]
    for key in env:
        command += ['--env', key]
    if volume:
        command += ['--volume', f'{volume}:/out:Z']
    command += [CONTAINER_IMAGE, 'bash', '-c', script]
    # nosec: fixed argument list, the inputs come from tools/follow-upstream.yml and the
    # command line of the developer running the tool
    return subprocess.run(  # nosec B603 B607
        command,
        env={**os.environ, **env},
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )


def is_prerelease(text):
    return re.search(PRERELEASE_RE, text, re.IGNORECASE) is not None


def fetch(app, config, fmt, package, version):
    """Return the directory holding /etc and the packaged files of `config` outside of
    /etc of `package` `version`, cached in CACHE_DIR. The install scripts of the package
    are saved next to it, see install_scripts().

    `fmt` is `rpm` or `deb`. The cache is per application, because two applications can
    ship different packages under the same name and version (Collabora CODE and
    Enterprise).
    """
    dest = os.path.join(CACHE_DIR, fmt, app, f'{package}-{version}')
    # a packaged file outside of /etc, e.g. a sample the package copies to /etc on
    # installation (Grafana's sample.ini), is extracted in addition to /etc
    extra = set()
    for entry in config['files']:
        path = entry.get('deb_path', entry['path']) if fmt == 'deb' else entry['path']
        if entry['package'] == package and not path.startswith('/etc/'):
            extra.add(path)
    extra = sorted(extra)
    root = os.path.join(dest, 'root')
    cached = all(
        os.path.isfile(os.path.join(dest, name)) for name in ('scripts', 'source')
    )
    if cached:
        with open(os.path.join(dest, 'source'), encoding='utf-8') as f:
            # `<repository> <package file>`, see the container scripts. A pre-release
            # build cached by an older version of this tool is fetched again.
            cached = ALLOW_PRERELEASE or not is_prerelease(f.read().split()[-1])
    if cached and all(
        os.path.exists(os.path.join(root, path.lstrip('/'))) for path in extra
    ):
        return root
    # an incomplete entry (killed run, an entry of an older version of this tool) is
    # fetched from scratch, cpio does not overwrite the files already there
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest)
    series = repo_series(config, version)
    gpg_key = config['gpg_key']
    sha1 = False
    # a series signed with another key than the current one (OpenSearch 2.x)
    if series in config.get('series_gpg_key', {}):
        gpg_key = config['series_gpg_key'][series]['url']
        sha1 = config['series_gpg_key'][series].get('sha1', False)
    gpg_key = expand(gpg_key.replace('{series}', series))
    if fmt == 'rpm':
        display = config['rpm_repo'].replace('{series}', series)
        env = {'REPO': expand(display)}
        script = container_script('fetch-rpm.sh')
    else:
        # `deb_repo` is written like a sources.list line: `<url> <suite> <component>`
        display, suite, component = (
            config['deb_repo'].replace('{series}', series).split()
        )
        env = {
            'COMPONENT': component,
            'REPO': expand(display).rstrip('/'),
            'SUITE': suite,
        }
        script = container_script('fetch-deb.sh')
    env.update(
        {
            'ALLOW_PRERELEASE': '1' if ALLOW_PRERELEASE else '',
            'EXTRACT': ' '.join(extra),
            'GPG_KEY': gpg_key,
            'GPG_SHA1': '1' if sha1 else '',
            'PACKAGE': package,
            'PRERELEASE_RE': PRERELEASE_RE,
            'REPO_DISPLAY': display,
            'VERSION': version,
        }
    )
    print(f'Fetching {package} {version} ({fmt}) from {display}', file=sys.stderr)
    result = run_container(script, env, volume=dest)
    if result.returncode != 0:
        raise FetchError(f'fetching {package} {version} ({fmt}) failed')
    return root


def package_file(root, path):
    """Return the host path of the packaged file `path` below `root`.

    A package can ship a symlink to a file outside of it (`coolwsd.xml -> ~/.ssh/id_rsa`),
    which would merge a file of the host into a template. Such a path is refused.
    """
    real_root = os.path.realpath(root)
    real_path = os.path.realpath(os.path.join(root, path.lstrip('/')))
    if os.path.commonpath([real_root, real_path]) != real_root:
        raise FetchError(f'{path} in {root} points outside of the package')
    return real_path


def packaged_files(root):
    """Return the paths of all files below `root`, as absolute paths on the host."""
    files = set()
    for dirpath, _, filenames in os.walk(root):
        for name in filenames:
            files.add('/' + os.path.relpath(os.path.join(dirpath, name), root))
    return files


def check_packaging(app, config, version):
    """Compare what the RPM and the DEB of `version` ship with tools/follow-upstream.yml.

    Without a `deb_repo`, only the RPM is checked. Returns the number of findings.
    """
    findings = 0
    ignore = set(config.get('ignore', []))
    # an entry ending in `/` ignores everything below that directory
    ignore_dirs = tuple(path for path in ignore if path.endswith('/'))
    fmts = ('rpm', 'deb') if 'deb_repo' in config else ('rpm',)
    for package in sorted({entry['package'] for entry in config['files']}):
        entries = [entry for entry in config['files'] if entry['package'] == package]
        roots = {fmt: fetch(app, config, fmt, package, version) for fmt in fmts}
        files = {fmt: packaged_files(root) for fmt, root in roots.items()}
        known = ignore.copy()
        for entry in entries:
            known.add(entry['path'])
            known.add(entry.get('deb_path', entry['path']))
        # files the DEB ships with other content than the RPM on purpose, so they have
        # a template of their own (MongoDB's mongod.conf)
        separate = {entry['path'] for entry in entries if entry.get('format') == 'deb'}

        for fmt in fmts:
            for path in sorted(files[fmt] - known):
                if path.startswith(ignore_dirs):
                    continue
                if not PATH_RE.fullmatch(path):
                    path = f'a file with an unusual name below {roots[fmt]}'
                print(
                    f'packaging: {package} {version} ({fmt}) ships {path}, which is'
                    ' neither templated nor ignored in tools/follow-upstream.yml'
                )
                findings += 1

        for entry in entries:
            # a template based on a later release does not take this one, e.g. one
            # without `{series}` that follows the newest series only (OpenSearch's
            # sysconfig and a 2.x release)
            source, _ = source_template(config, entry, version)
            base = read_based_on(source) if source else None
            if base and version_key(base) > version_key(version):
                continue
            rpm_path = entry['path']
            deb_path = entry.get('deb_path', rpm_path)
            paths = {'rpm': rpm_path, 'deb': deb_path}
            if entry.get('format') == 'deb':
                del paths['rpm']
            elif rpm_path in separate:
                del paths['deb']
            missing = False
            for fmt, path in paths.items():
                if fmt in files and path not in files[fmt]:
                    print(
                        f'packaging: {package} {version} ({fmt}) no longer ships {path}'
                    )
                    findings += 1
                    missing = True
            if missing or len(paths) < 2 or 'deb' not in roots:
                continue
            rpm_file = package_file(roots['rpm'], rpm_path)
            deb_file = package_file(roots['deb'], deb_path)
            with open(rpm_file, 'rb') as f1, open(deb_file, 'rb') as f2:
                if f1.read() != f2.read():
                    print(
                        f'packaging: {package} {version} ships different files in the'
                        f' RPM and the DEB: diff {rpm_file} {deb_file}'
                    )
                    findings += 1
    return findings


def check_scripts(app, config, version):
    """Compare the install scripts of `version` with those of the releases the templates
    are based on. Returns the number of findings.

    A template is a copy of the packaged file. If an install script starts to modify the
    file on the host (`sed` on the copied sample, a generated secret), the template does
    not get that change, and deploying it would revert it.
    """
    fmts = ('rpm', 'deb') if 'deb_repo' in config else ('rpm',)
    bases = set()
    for entry in config['files']:
        source, _ = source_template(config, entry, version)
        base = read_based_on(source) if source else None
        if base and version_key(base) < version_key(version):
            bases.add((entry['package'], base))
    findings = 0
    for package, base in sorted(bases):
        for fmt in fmts:
            old, new = (
                os.path.join(
                    os.path.dirname(fetch(app, config, fmt, package, release)),
                    'scripts',
                )
                for release in (base, version)
            )
            if without_version(old, base) != without_version(new, version):
                print(
                    f'packaging: {package} {version} ({fmt}) has other install'
                    f' scripts than {base}: diff {old} {new}'
                )
                findings += 1
    return findings


def without_version(path, version):
    """Return the content of the install scripts `path` of `version`, with the version
    replaced by a placeholder.

    Some packages embed their version in the scripts (Elasticsearch:
    `RPM_PACKAGE_VERSION=9.5.5`, `# Built for packages-9.5.5 (rpm)`), which would make
    every release a finding. A build suffix (`9.5.5-1`) is part of the version, a longer
    version (`9.5.50`, `19.5.5`) is not.
    """
    with open(path, encoding='utf-8', errors='surrogateescape') as f:
        text = f.read()
    regex = rf'(?<![\d.]){re.escape(version)}(?:-\d+)?(?!\.?\d)'
    return re.sub(regex, '<version>', text)


def read_based_on(path):
    with open(path, encoding='utf-8') as f:
        lines = f.read().splitlines()
    for line in lines[:HEADER_LINES]:
        match = BASED_ON_RE.search(line)
        if match:
            return match.group('version')
    return None


def report_old_series(text, old_series):
    """Print the lines of a new template that still mention the old series.

    Catches version-specific references the merge cannot know about, e.g. the
    `go2docs.graylog.org/7-1/` documentation link in a template copied for 7.2.
    """
    separators = re.escape(old_series).replace(r'\.', '[.\\-_]')
    regex = re.compile(rf'(?<![\d.]){separators}(?![\d])')
    for number, line in enumerate(text.splitlines(), start=1):
        if regex.search(line):
            print(f'  line {number} mentions {old_series}: {line.strip()}')


def new_timestamp(old, new_file):
    today = datetime.date.today().strftime('%Y%m%d')
    if old.startswith(today) and not new_file:
        return f'{int(old) + 1}'
    return f'{today}01'


def update_header(text, package, version, old_series, new_series, bump=True):
    """Set the timestamp, the series line and the `Based on` line of the header.

    Without `bump`, the timestamp is kept: only the Jinja comment changes, which does not
    end up in the deployed file.
    """
    lines = text.splitlines(keepends=True)
    prefix = suffix = None
    stamp_index = None
    for i, line in enumerate(lines[:HEADER_LINES]):
        match = TIMESTAMP_RE.match(line.rstrip('\n'))
        if match:
            prefix, suffix = match.group('prefix'), match.group('suffix')
            stamp_index = i
            if bump:
                stamp = new_timestamp(match.group('stamp'), old_series != new_series)
                lines[i] = f'{prefix}{stamp}{suffix}\n'
            break
    if stamp_index is None:
        sys.exit('No YYYYMMDDNN timestamp line found in the template header')

    series_index = None
    for i, line in enumerate(lines[:HEADER_LINES]):
        # the series line is written like the timestamp line: `# 7.2`, `<!-- 26.04.5 -->`
        if line.rstrip('\n') == f'{prefix}{old_series}{suffix}':
            lines[i] = f'{prefix}{new_series}{suffix}\n'
            series_index = i
            break

    based_on = f'{{# Based on {package} {version} #}}\n'
    for i, line in enumerate(lines[:HEADER_LINES]):
        if BASED_ON_RE.search(line):
            lines[i] = based_on
            break
    else:
        anchor = series_index if series_index is not None else stamp_index
        lines.insert(anchor + 1, based_on)
    return ''.join(lines)


def add_supported_version(spec, series):
    """Add `series` to the YAML list `file:variable` in version order, keeping comments.

    `file:variable.key` addresses the list below the key `key` of the dictionary
    `variable`, e.g. one list per OS family.
    """
    path, variable = spec.split(':')
    path = os.path.join(REPO_ROOT, path)
    with open(path, encoding='utf-8') as f:
        lines = f.read().splitlines(keepends=True)
    keys = variable.split('.')
    start = -1
    for depth, key in enumerate(keys):
        start = next(
            i
            for i, line in enumerate(lines)
            if i > start and line.startswith(f'{"  " * depth}{key}:')
        )
    item = '  ' * len(keys) + '- '
    end = start + 1
    while end < len(lines) and lines[end].startswith(item):
        end += 1
    if f"{item}'{series}'\n" in lines[start + 1 : end]:
        return
    # before the first newer entry, so a series of an older line (25.04.14 after 26.04.4
    # was released) does not end up at the bottom
    position = end
    for i in range(start + 1, end):
        if version_key(lines[i].strip().removeprefix('- ').strip("'")) > version_key(
            series
        ):
            position = i
            break
    lines.insert(position, f"{item}'{series}'\n")
    with open(path, 'w', encoding='utf-8') as f:
        f.writelines(lines)
    print(f'  added {series} to {os.path.relpath(path, REPO_ROOT)}')


def write_template(entry, target, text):
    for path in [target] + [
        os.path.join(REPO_ROOT, c) for c in entry.get('copies', [])
    ]:
        with open(path, 'w', encoding='utf-8') as f:
            f.write(text)


def source_template(config, entry, version):
    """Return (path, series) of the template that `version` is merged from: the template
    of its series, or for a new release series the template of the latest older series.
    (None, None) if there is none."""
    new_series = series_of(version, config['series_parts'])
    target = os.path.join(REPO_ROOT, entry['template'].format(series=new_series))
    if os.path.isfile(target):
        return target, new_series
    pattern = os.path.join(REPO_ROOT, entry['template'].format(series='*'))
    regex = re.escape(entry['template']).replace(r'\{series\}', '(?P<series>.+)')
    candidates = []
    for path in glob.glob(pattern):
        match = re.fullmatch(regex, os.path.relpath(path, REPO_ROOT))
        if match and version_key(match['series']) < version_key(new_series):
            candidates.append((version_key(match['series']), match['series'], path))
    if not candidates:
        return None, None
    _, old_series, source = max(candidates)
    return source, old_series


def update_file(app, config, entry, version, dry_run):
    new_series = series_of(version, config['series_parts'])
    target = os.path.join(REPO_ROOT, entry['template'].format(series=new_series))
    rel_target = os.path.relpath(target, REPO_ROOT)

    source, old_series = source_template(config, entry, version)
    if source is None:
        print(f'{rel_target}: no older template to start from')
        return 'error'

    base = read_based_on(source)
    rel_source = os.path.relpath(source, REPO_ROOT)
    if base is None:
        print(f'{rel_source}: no "Based on <package> <version>" line in the header')
        return 'error'
    if version_key(base) >= version_key(version):
        print(f'{rel_source}: based on {base}, already covers {version}')
        return 'covered'

    # the template is a copy of the RPM file, unless the entry names the DEB
    fmt = entry.get('format', 'rpm')
    packaged = entry.get('deb_path', entry['path']) if fmt == 'deb' else entry['path']
    base_file = package_file(fetch(app, config, fmt, entry['package'], base), packaged)
    new_file = package_file(
        fetch(app, config, fmt, entry['package'], version), packaged
    )
    for path, release in ((base_file, base), (new_file, version)):
        if not os.path.isfile(path):
            print(f'{rel_source}: {entry["package"]} {release} has no {packaged}')
            return 'error'

    with open(base_file, 'rb') as f1, open(new_file, 'rb') as f2:
        upstream_changed = f1.read() != f2.read()
    if not upstream_changed and source == target:
        print(f'{rel_source}: {packaged} is identical in {base} and {version}')
        if not dry_run:
            with open(source, encoding='utf-8') as f:
                text = f.read()
            text = update_header(
                text,
                entry['package'],
                version,
                series_name(config, old_series),
                series_name(config, new_series),
                bump=False,
            )
            write_template(entry, target, text)
        return 'unchanged'

    merge = subprocess.run(  # nosec B603 B607 - fixed argument list, file paths only
        [
            'git',
            'merge-file',
            '--stdout',
            '-L',
            f'{rel_source} (LFOps)',
            '-L',
            f'{entry["package"]} {base}',
            '-L',
            f'{entry["package"]} {version}',
            source,
            base_file,
            new_file,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if merge.returncode < 0 or merge.returncode > 127:
        sys.exit(f'git merge-file failed: {merge.stderr}')
    conflicts = merge.returncode
    merged = update_header(
        merge.stdout,
        entry['package'],
        version,
        series_name(config, old_series),
        series_name(config, new_series),
    )

    status = f'{conflicts} conflict(s)' if conflicts else 'merged cleanly'
    print(f'{rel_target}: {base} -> {version} from {rel_source}, {status}')
    print(f'  upstream diff: diff {base_file} {new_file}')
    if dry_run:
        return 'conflicts' if conflicts else 'merged'
    write_template(entry, target, merged)
    if source != target:
        add_supported_version(
            entry['supported_versions'], series_name(config, new_series)
        )
        report_old_series(merged, series_name(config, old_series))
    return 'conflicts' if conflicts else 'merged'


def tracked_templates(entry, parts):
    """Return {series: based-on version} of the templates of `entry` with a `Based on`
    line. A template without `{series}` is returned under the series of its base."""
    if '{series}' not in entry['template']:
        base = read_based_on(os.path.join(REPO_ROOT, entry['template']))
        return {series_of(base, parts): base} if base else {}
    templates = {}
    for series, path in template_series(entry).items():
        base = read_based_on(path)
        if base:
            templates[series] = base
    return templates


def template_series(entry):
    """Return {series: path} of the existing templates of an entry with `{series}`."""
    pattern = os.path.join(REPO_ROOT, entry['template'].format(series='*'))
    regex = re.escape(entry['template']).replace(r'\{series\}', '(?P<series>.+)')
    templates = {}
    for path in glob.glob(pattern):
        match = re.fullmatch(regex, os.path.relpath(path, REPO_ROOT))
        if match:
            templates[match['series']] = path
    return templates


def repo_series_list(config, known):
    """The repository series to query for the template series `known`, including the
    series that can follow the newest one."""
    if '{series}' not in config['rpm_repo']:
        return ['-']
    known = {repo_series(config, series) for series in known}
    newest = max(known, key=version_key)
    return sorted(known | set(next_series(newest)), key=version_key)


def next_series(series):
    """The series that can follow `series`: `7.2` -> `7.3`, `8.0`, and `8.2` for
    versions named after the release month (`26.04` -> `27.04`). Probing a repository
    that does not exist costs nothing."""
    parts = series.split('.')
    minor = [*parts[:-1], str(int(parts[-1]) + 1)]
    major = [str(int(parts[0]) + 1), *['0'] * (len(parts) - 1)]
    yearly = [str(int(parts[0]) + 1), *parts[1:]]
    return sorted({'.'.join(minor), '.'.join(major), '.'.join(yearly)})


def list_versions(config, packages, series_list):
    """Return {package: {version, ...}} over the RPM repositories of `series_list`."""
    repos = []
    for series in series_list:
        repos.append(
            f'{series} {expand(config["rpm_repo"].replace("{series}", series))}'
        )
    result = run_container(
        container_script('list-rpm.sh'),
        {'PACKAGES': ' '.join(sorted(packages)), 'REPOS': '\n'.join(repos)},
    )
    if result.returncode != 0:
        raise FetchError('listing the packages failed')
    versions = {package: set() for package in packages}
    unusual = 0
    prereleases = 0
    for line in result.stdout.splitlines():
        fields = line.split()
        if (
            len(fields) != 4
            or fields[1] not in versions
            or not VERSION_RE.fullmatch(fields[2])
        ):
            unusual += 1
            continue
        # Graylog ships 7.3.0-alpha.1 as version `7.3.0`, release `1.alpha.1`
        if is_prerelease(fields[3]):
            prereleases += 1
            continue
        versions[fields[1]].add(fields[2])
    if unusual:
        print(f'{unusual} unusual package version(s) ignored', file=sys.stderr)
    if prereleases:
        print(f'{prereleases} pre-release build(s) ignored', file=sys.stderr)
    return versions


def check_app(app, config):
    """Return the releases of `app` that need a run of this tool, oldest first.

    Per release series, the latest release counts if it is newer than the template's
    `Based on` line. A series newer than every template of its repository series is a
    new release series (Collabora maintains `25.04.x` and `26.04.x` in parallel). Series
    older than that without a template of their own are ignored.
    """
    parts = config['series_parts']
    entries = [(entry, tracked_templates(entry, parts)) for entry in config['files']]
    entries = [(entry, templates) for entry, templates in entries if templates]
    if not entries:
        return []
    known = {series for _, templates in entries for series in templates}
    series_list = repo_series_list(config, known)
    versions = list_versions(
        config, {entry['package'] for entry, _ in entries}, series_list
    )

    releases = {}
    for entry, templates in entries:
        if not versions[entry['package']]:
            raise FetchError(f'no {entry["package"]} package found')
        newest = {}
        for series in templates:
            line = repo_series(config, series)
            if line not in newest or version_key(series) > version_key(newest[line]):
                newest[line] = series
        overall = max(templates, key=version_key)
        latest = {}
        for version in versions[entry['package']]:
            series = series_of(version, parts)
            if series in latest and version_key(latest[series]) > version_key(version):
                continue
            latest[series] = version
        if '{series}' not in entry['template']:
            # one template for every series: only the newest release counts, also if it
            # belongs to a later series than the template's `Based on` release
            version = max(latest.values(), key=version_key)
            (base,) = templates.values()
            if version_key(version) > version_key(base):
                releases[version] = releases.get(version, False)
            continue
        for series, version in latest.items():
            if series in templates:
                if version_key(version) > version_key(templates[series]):
                    releases[version] = releases.get(version, False)
            elif '{series}' in entry['template'] and version_key(series) > version_key(
                newest.get(repo_series(config, series), overall)
            ):
                releases[version] = True
    return [
        {'app': app, 'new_series': new_series, 'version': version}
        for version, new_series in sorted(
            releases.items(), key=lambda item: version_key(item[0])
        )
    ]


def check(manifest, apps, as_json):
    releases = []
    failed = False
    for app in apps:
        try:
            releases += check_app(app, manifest[app])
        except MissingEnvError as e:
            print(f'{app}: skipped, {e}', file=sys.stderr)
        except FetchError as e:
            print(f'{app}: {e}', file=sys.stderr)
            failed = True
    if as_json:
        print(json.dumps(releases, indent=2))
    else:
        for release in releases:
            kind = 'new release series' if release['new_series'] else 'release'
            print(f'{release["app"]} {release["version"]}: {kind}')
    if failed:
        sys.exit(2)
    if releases:
        sys.exit(1)


def list_releases(config):
    """Print every release in the repositories of the existing templates, with or
    without a `Based on` line. Used to bootstrap the `Based on` lines."""
    known = set()
    for entry in config['files']:
        if '{series}' in entry['template']:
            known |= set(template_series(entry))
        else:
            base = read_based_on(os.path.join(REPO_ROOT, entry['template']))
            if base:
                known.add(series_of(base, config['series_parts']))
    # a repository without `{series}` serves every release, nothing to derive
    if not known and '{series}' in config['rpm_repo']:
        sys.exit('No template to derive the release series from')
    packages = {entry['package'] for entry in config['files']}
    versions = list_versions(config, packages, repo_series_list(config, known))
    for package in sorted(versions):
        for version in sorted(versions[package], key=version_key):
            print(f'{package} {version}')


def main():
    parser = argparse.ArgumentParser(
        description=__doc__.split('\n\n', maxsplit=1)[0],
        epilog=f'Applications: {MANIFEST}. Packaged files are cached in {CACHE_DIR}.',
    )
    parser.add_argument(
        'app',
        nargs='?',
        help='Application from tools/follow-upstream.yml, or its upstream project name '
        '(`Graylog2/graylog2-server`). Optional with `--check`.',
    )
    parser.add_argument(
        'version',
        nargs='?',
        help='The new upstream release, e.g. `7.2.1`. Not used with `--check` and '
        '`--list`.',
    )
    parser.add_argument(
        '--allow-prerelease',
        action='store_true',
        help='Fetch and merge a pre-release build (`7.3.0-1.alpha.1`) if the release '
        'has no final build.',
    )
    parser.add_argument(
        '--check',
        action='store_true',
        help='List the releases that are newer than the templates, of every application '
        'or of `app`, without fetching or writing anything.',
    )
    parser.add_argument(
        '--dry-run',
        action='store_true',
        help='Fetch, check and merge, but do not write any file.',
    )
    parser.add_argument(
        '--list',
        action='store_true',
        help='List every release of `app` in the repositories of its templates, e.g. to '
        'find the release a template is based on.',
    )
    parser.add_argument(
        '--json',
        action='store_true',
        help='With `--check`: print the releases as JSON.',
    )
    args = parser.parse_args()

    with open(MANIFEST, encoding='utf-8') as f:
        manifest = yaml.safe_load(f)
    remove_leftover_containers()

    if args.check:
        if args.version:
            parser.error('--check takes no version')
        apps = [find_app(manifest, args.app)[0]] if args.app else sorted(manifest)
        check(manifest, apps, args.json)
        return
    if args.list:
        if not args.app or args.version:
            parser.error('--list takes an application and no version')
        try:
            list_releases(find_app(manifest, args.app)[1])
        except (FetchError, MissingEnvError) as e:
            sys.exit(str(e))
        return
    if not args.version:
        parser.error('the version is required')
    if not VERSION_RE.fullmatch(args.version):
        parser.error('the version consists of numbers and dots, e.g. `7.2.1`')

    global ALLOW_PRERELEASE  # read by fetch()
    ALLOW_PRERELEASE = args.allow_prerelease
    app, config = find_app(manifest, args.app)
    try:
        findings = check_packaging(app, config, args.version)
        findings += check_scripts(app, config, args.version)
        results = [
            update_file(app, config, entry, args.version, args.dry_run)
            for entry in config['files']
        ]
    except (FetchError, MissingEnvError) as e:
        print(f'{e}, see the output above', file=sys.stderr)
        sys.exit(2)
    if 'error' in results:
        sys.exit(2)
    if findings or 'conflicts' in results:
        sys.exit(1)


if __name__ == '__main__':
    main()

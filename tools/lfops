# --- helpers ---------------------------------------------------------------------------


class _AnyTagLoader(getattr(yaml, 'CSafeLoader', yaml.SafeLoader)):
    """SafeLoader that accepts `!vault`, `!unsafe` and other tags without resolving
    them. Only keys and structure of the files are of interest here."""


_AnyTagLoader.add_multi_constructor('!', lambda _loader, _suffix, _node: None)


def load_yaml(path):
    try:
        with open(path, encoding='utf-8') as f:
            # a SafeLoader, see _AnyTagLoader
            return yaml.load(f, Loader=_AnyTagLoader)  # nosec B506
    except (OSError, yaml.YAMLError):
        return None


def find_lfops_dir():
    """The checkout ansible-navigator mounts as the collection, see
    ~/.ansible-navigator.yml. Falls back to the installed collection."""
    candidates = [os.environ.get('LFOPS_DIR', '')]
    if os.environ.get('LF_GITHUB'):
        candidates.append(os.path.join(os.environ['LF_GITHUB'], 'lfops'))
    candidates.append(
        os.path.expanduser(
            '~/.ansible/collections/ansible_collections/linuxfabrik/lfops'
        )
    )
    for candidate in candidates:
        if candidate and os.path.isdir(os.path.join(candidate, 'playbooks')):
            return candidate
    return None


def inventory_glob():
    default = os.path.join(os.environ.get('LF_GITLAB', '.'), '*', 'ans', 'hosts.yml')
    return os.path.expanduser(os.environ.get('LFOPS_INVENTORIES', default))


def shorten_path(path):
    """Reduce every component of a path except the last one to its first character,
    like the zsh prompt does: "/home/user/git/lfops" -> "/h/u/g/lfops". The same as
    shorten_path() in the dashboard callback."""
    if not path or '/' not in path:
        return path
    head, _, tail = path.rpartition('/')
    return '/'.join(part[:1] for part in head.split('/')) + f'/{tail}'


def lfops_origin(lfops_dir):
    """The LFOps checkout as the dashboard callback names it, e.g. "LFOps
    main@3e8a7b75, 2 uncommitted", or without git its version, e.g. "LFOps 6.1.0",
    followed by its shortened path."""
    version = None
    try:
        with open(os.path.join(lfops_dir, 'MANIFEST.json'), encoding='utf-8') as f:
            version = json.load(f)['collection_info']['version']
    except (OSError, ValueError, KeyError):
        galaxy = load_yaml(os.path.join(lfops_dir, 'galaxy.yml'))
        if isinstance(galaxy, dict):
            version = galaxy.get('version')
    origin = f'LFOps {version or "unknown"}'

    def git(*args):
        try:
            proc = subprocess.run(  # nosec B603 B607
                ['git', '-C', lfops_dir, *args],
                capture_output=True,
                check=False,
                text=True,
                timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            return None
        return proc.stdout.strip() if proc.returncode == 0 else None

    if os.path.exists(os.path.join(lfops_dir, '.git')):
        branch = git('rev-parse', '--abbrev-ref', 'HEAD')
        commit = git('rev-parse', '--short=8', 'HEAD')
        if branch and commit:
            origin = f'LFOps {branch}@{commit}'
            changed = git('status', '--porcelain', '--untracked-files=no')
            if changed:
                origin += f', {len(changed.splitlines())} uncommitted'
    return f'{origin}   {shorten_path(os.path.abspath(lfops_dir))}'


def plural(count, word):
    return f'{count} {word}' if count == 1 else f'{count} {word}s'


def by_recency(values, used):
    """Sort `values`: the ones in `used` (value -> timestamp) newest first, then the
    rest in their given order."""
    recent = sorted((v for v in values if v in used), key=lambda v: -used[v])
    return recent + [v for v in values if v not in used]


# --- history ---------------------------------------------------------------------------


def load_history():
    try:
        with open(HISTORY_FILE, encoding='utf-8') as f:
            history = json.load(f)
    except (OSError, ValueError):
        history = {}
    for key in ('inventories', 'limits', 'options', 'playbooks', 'tags'):
        history.setdefault(key, {})
    runs = history.get('runs')
    history['runs'] = (
        [r for r in runs if _valid_run(r)] if isinstance(runs, list) else []
    )
    return history


def _valid_run(run):
    """True if a run of the history file has the keys and types the UI expects, so a
    hand-edited or broken file cannot crash the tool."""

    def strings(value):
        return isinstance(value, list) and all(isinstance(v, str) for v in value)

    if not isinstance(run, dict) or not isinstance(run.get('time'), (int, float)):
        return False
    requested = run.get('requested')
    return (
        isinstance(run.get('playbook'), str)
        and strings(run.get('inventories'))
        and len(run['inventories']) > 0
        and all(strings(run.get(k, [])) for k in ('limits', 'options', 'tags'))
        and isinstance(run.get('note', ''), str)
        and isinstance(run.get('role'), (str, type(None)))
        and (
            requested is None
            or (
                isinstance(requested, list)
                and len(requested) == 2
                and isinstance(requested[0], str)
                and strings(requested[1])
            )
        )
    )


def _touch(mapping, values, now):
    for value in values:
        mapping[value] = now
    # keep the newest entries only
    for value in sorted(mapping, key=lambda v: mapping[v])[:-HISTORY_SIZE]:
        del mapping[value]


def save_history(history, state):
    playbook, inventories = state['playbook'], state['inventories']
    now = time.time()
    _touch(history['options'], state['options'], now)
    _touch(history['playbooks'], [playbook], now)
    _touch(history['tags'].setdefault(playbook, {}), state['tags'], now)
    _touch(history['inventories'], inventories, now)
    for inventory in inventories:
        _touch(history['limits'].setdefault(inventory, {}), state['limits'], now)
    # the same run again moves to the top
    run = {key: state[key] for key in EMPTY_STATE}
    runs = [r for r in history['runs'] if {k: r.get(k) for k in EMPTY_STATE} != run]
    history['runs'] = [{**run, 'time': now}, *runs][:HISTORY_SIZE]
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = HISTORY_FILE + '.tmp'
        # typed options such as --extra-vars may hold secrets
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with open(fd, 'w', encoding='utf-8') as f:
            json.dump(history, f, indent=2, sort_keys=True)
        os.replace(tmp, HISTORY_FILE)
    except OSError as e:
        print(f'lfops: could not save the history: {e}', file=sys.stderr)


# --- playbooks, roles and tags ---------------------------------------------------------


def list_playbooks(lfops_dir):
    paths = glob.glob(os.path.join(lfops_dir, 'playbooks', '*.yml'))
    return sorted(os.path.splitext(os.path.basename(p))[0] for p in paths)


def _role_name(name):
    """'linuxfabrik.lfops.aide' -> 'aide'. Roles of other collections -> None."""
    if not isinstance(name, str) or '{' in name:
        return None
    if name.startswith(ROLE_PREFIX):
        return name[len(ROLE_PREFIX) :]
    if '.' in name:
        return None
    return name


SKIP_CONDITION = re.compile(
    r'^not\s+([A-Za-z_]\w*)\s*\|\s*(?:d|default)\(\s*(?:false|False)\s*\)$'
)


def _skip_vars(when, inherited=frozenset()):
    """The variables of `when` conditions like `not setup_basic__skip_aide | d(false)`,
    with which an inventory can skip a role. Other conditions are ignored."""
    conditions = when if isinstance(when, list) else [when]
    found = {
        m.group(1)
        for c in conditions
        if isinstance(c, str) and (m := SKIP_CONDITION.match(c.strip()))
    }
    return frozenset(inherited | found)


def _roles_from_tasks(tasks, inherited=frozenset()):
    """Returns [(role, skip variables)] of the import_role and include_role tasks."""
    roles = []
    for task in tasks if isinstance(tasks, list) else []:
        if not isinstance(task, dict):
            continue
        skip = _skip_vars(task.get('when'), inherited)
        for key in ROLE_TASK_KEYS:
            if isinstance(task.get(key), dict):
                roles.append((_role_name(task[key].get('name')), skip))
        for key in BLOCK_KEYS:
            roles.extend(_roles_from_tasks(task.get(key), skip))
    return roles


def playbook_plays(lfops_dir, playbook, seen=None):
    """Returns the plays of a playbook, imported playbooks resolved, in play order, as
    a list of (target groups, roles, {role: [skip variables per occurrence]})."""
    seen = set() if seen is None else seen
    if playbook in seen:
        return []
    seen.add(playbook)
    plays = load_yaml(os.path.join(lfops_dir, 'playbooks', f'{playbook}.yml'))
    result = []
    for play in plays if isinstance(plays, list) else []:
        if not isinstance(play, dict):
            continue
        imported = next((play[k] for k in IMPORT_PLAYBOOK_KEYS if k in play), None)
        if isinstance(imported, str):
            name = os.path.splitext(os.path.basename(imported))[0]
            name = name[len(ROLE_PREFIX) :] if name.startswith(ROLE_PREFIX) else name
            result.extend(playbook_plays(lfops_dir, name, seen))
            continue
        hosts = play.get('hosts', [])
        if isinstance(hosts, str):
            hosts = [h.strip() for h in hosts.split(',')]
        hosts = [h for h in hosts if isinstance(h, str) and '{' not in h]
        # execution order of a play
        found = _roles_from_tasks(play.get('pre_tasks'))
        for role in play.get('roles') or []:
            if isinstance(role, dict):
                name = _role_name(role.get('role', role.get('name')))
                found.append((name, _skip_vars(role.get('when'))))
            else:
                found.append((_role_name(role), frozenset()))
        for key in ('tasks', 'post_tasks', 'handlers'):
            found.extend(_roles_from_tasks(play.get(key)))
        found = [(r, skip) for r, skip in found if r]
        skips = {}
        for role, skip in found:
            skips.setdefault(role, []).append(skip)
        roles = _with_dependencies(lfops_dir, [r for r, _ in found])
        result.append((hosts, list(dict.fromkeys(roles)), skips))
    return result


def playbook_info(lfops_dir, playbook):
    """Returns (roles, target groups) of a playbook, in play order."""
    roles, hosts = [], []
    for play_hosts, play_roles, _ in playbook_plays(lfops_dir, playbook):
        hosts.extend(play_hosts)
        roles.extend(play_roles)
    return list(dict.fromkeys(roles)), list(dict.fromkeys(hosts))


def _with_dependencies(lfops_dir, roles, seen=None):
    seen = set() if seen is None else seen
    result = []
    for role in roles:
        if role in seen:
            continue
        seen.add(role)
        meta = load_yaml(os.path.join(lfops_dir, 'roles', role, 'meta', 'main.yml'))
        deps = meta.get('dependencies') if isinstance(meta, dict) else None
        dep_names = [
            _role_name(d.get('role', d.get('name')) if isinstance(d, dict) else d)
            for d in deps or []
        ]
        result.extend(_with_dependencies(lfops_dir, [d for d in dep_names if d], seen))
        result.append(role)
    return result


TAG_LINE = re.compile(r'^`([^`\s]+)`\s*$')


def role_tags(lfops_dir, role):
    """Returns [(tag, description)] from the "## Tags" section of the role README.

    The format is the one of roles/example/README.md: a line with the tag in backticks,
    followed by a bullet list."""
    try:
        with open(
            os.path.join(lfops_dir, 'roles', role, 'README.md'), encoding='utf-8'
        ) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    tags, in_section = [], False
    for line in lines:
        if line.startswith('## '):
            in_section = line.strip() == '## Tags'
            continue
        if not in_section:
            continue
        match = TAG_LINE.match(line)
        if match:
            tags.append([match.group(1), '', False])
        elif tags and line.startswith(('* ', '- ')):
            bullet = line[2:].strip()
            if bullet.startswith('Not run by default'):
                tags[-1][2] = True
            elif not tags[-1][1]:
                tags[-1][1] = bullet
    return [
        (tag, f'[only if given] {desc}' if never else desc) for tag, desc, never in tags
    ]


# --- inventories -----------------------------------------------------------------------


def list_inventories():
    # empty files define no hosts
    return sorted(p for p in glob.glob(inventory_glob()) if os.path.getsize(p))


class Inventory:
    """Groups and hosts of a YAML inventory, plus the lookup of single variables in its
    group_vars and host_vars. `direct` and `children` hold the group structure as
    written, `groups` the resolved members, see merged_groups()."""

    def __init__(self, path):
        self.path = path
        self.dir = os.path.dirname(path)
        self.direct, self.children = {}, {}
        self.inline_group_vars, self.inline_host_vars = {}, {}

        def walk(group, node):
            self.direct.setdefault(group, set())
            self.children.setdefault(group, set())
            if not isinstance(node, dict):
                return
            if isinstance(node.get('vars'), dict):
                self.inline_group_vars.setdefault(group, {}).update(node['vars'])
            if isinstance(node.get('hosts'), dict):
                for host, host_vars in node['hosts'].items():
                    self.direct[group].add(str(host))
                    if isinstance(host_vars, dict):
                        self.inline_host_vars.setdefault(str(host), {}).update(
                            host_vars
                        )
            if isinstance(node.get('children'), dict):
                for child, child_node in node['children'].items():
                    self.children[group].add(str(child))
                    walk(str(child), child_node)

        data = load_yaml(path)
        if isinstance(data, dict):
            for group, node in data.items():
                walk(str(group), node)

        self.groups = merged_groups([self])
        self._files = {}

    def _depth(self, group, seen=()):
        parents = [g for g, c in self.children.items() if group in c and g not in seen]
        return 1 + max((self._depth(p, (*seen, group)) for p in parents), default=-1)

    def _from_files(self, kind, name, var):
        """Value of `var` in group_vars/<name> or host_vars/<name>, or KeyError."""
        key = (kind, name)
        if key not in self._files:
            base = os.path.join(self.dir, kind, name)
            paths = [f'{base}{ext}' for ext in ('', '.yml', '.yaml')]
            paths += sorted(glob.glob(os.path.join(glob.escape(base), '*.y*ml')))
            self._files[key] = [p for p in paths if os.path.isfile(p)]
        value = KeyError
        for path in self._files[key]:
            try:
                with open(path, encoding='utf-8') as f:
                    if var not in f.read():  # avoid parsing files without the variable
                        continue
            except (OSError, UnicodeDecodeError):
                continue
            data = load_yaml(path)
            if isinstance(data, dict) and var in data:
                value = data[var]
        if value is KeyError:
            raise KeyError(var)
        return value

    def value(self, host, var):
        """Value of `var` for `host`, following the precedence of Ansible: host_vars,
        then the group_vars of the deepest group (by name on equal depth), `all` last.
        KeyError if the variable is not set."""
        if var in self.inline_host_vars.get(host, {}):
            return self.inline_host_vars[host][var]
        try:
            return self._from_files('host_vars', host, var)
        except KeyError:
            pass
        groups = [g for g, h in self.groups.items() if host in h and g != 'all']
        groups.sort(key=lambda g: (self._depth(g), g), reverse=True)
        for group in [*groups, 'all']:
            try:
                return self._from_files('group_vars', group, var)
            except KeyError:
                pass
            if var in self.inline_group_vars.get(group, {}):
                return self.inline_group_vars[group][var]
        raise KeyError(var)


def merged_groups(inventories):
    """{group: hosts} over several Inventory objects. Like Ansible, the group structure
    (direct hosts and children) of all inventories is merged first and the members are
    resolved after, so a group of one inventory can get hosts from a child group defined
    in another. A group of the same name in several inventories is one group."""
    direct, children = {}, {}
    for inventory in inventories:
        for group, hosts in inventory.direct.items():
            direct.setdefault(group, set()).update(hosts)
        for group, child_groups in inventory.children.items():
            children.setdefault(group, set()).update(child_groups)

    def members(group, seen):
        if group in seen:
            return set()
        seen.add(group)
        result = set(direct.get(group, ()))
        for child in children.get(group, ()):
            result |= members(child, seen)
        return result

    groups = {group: members(group, set()) for group in direct}
    all_hosts = set().union(*groups.values())
    # like InventoryData.reconcile_inventory(): a host is in `ungrouped` if it is in no
    # group other than `all`, even if an inventory lists it there explicitly
    grouped = set().union(
        *(h for g, h in groups.items() if g not in ('all', 'ungrouped'))
    )
    groups['all'] = all_hosts
    groups['ungrouped'] = all_hosts - grouped
    return groups


# --- limit patterns --------------------------------------------------------------------

# Resolves `--limit` the way ansible-core does in lib/ansible/inventory/manager.py
# (split_host_pattern(), subset(), order_patterns(), _evaluate_patterns(),
# _match_one_pattern(), _enumerate_matches()). Verified against the ansible-core
# 2.22.0.dev0 source and with ansible-core 2.16.19 (same logic) by comparing with
# `ansible all --list-hosts --limit=<pattern>` on a test inventory.
#
# Pattern forms:
# * `host`, `group`: supported. A host name wins over a group of the same name, but
#   not after `&` or `!`.
# * fnmatch globs (`web*`, `db?`, `[ab]*`): supported, they match group and host names.
# * `a,b` and `a:b`: supported, as union. Colons only separate if there is no comma.
# * `&pattern`, `!pattern`: supported, applied after all others (& first, then !). A
#   limit of only `&` and `!` entries starts from `all`.
# * `all`, `ungrouped`: supported.
# * `~regex`: not supported, kept out for simplicity, rarely used in a limit.
# * `@file`: not supported, Ansible reads the file inside the execution environment.
# * `group[0]`, `group[0:2]`: not supported, they depend on the order of the hosts in
#   the inventory, which the sets here do not keep.
# * `host:port`, IPv6 addresses: not supported. Without a comma, Ansible takes what
#   parse_address() accepts as one pattern instead of splitting at the colons. That
#   includes some strings with `::` that are no address (`db::web`), so a limit with
#   `::` and without a comma counts as not supported.
# * `{{ ... }}`: taken as text like Ansible does, it does not template the limit.
LIMIT_COLON_SPLIT = re.compile(r'(?:[^\s:\[\]]|\[[^\]]*\])+')
LIMIT_HOSTPORT = re.compile(r'^(?:(?:[^:\[\]]|\[[^\]]*\])*|\[.+\]):[0-9]+$')
LIMIT_IPV6 = re.compile(r'^[0-9a-fA-F:.\[\]]+$')
LIMIT_SUBSCRIPT = re.compile(r'^(.+)\[(?:-?[0-9]+|[0-9]+[:-][0-9]*)\]$')


def split_limit(limit):
    """Splits a `--limit` value into single patterns like split_host_pattern(). None if
    Ansible may take it as one address (`host:22`, IPv6, `::`) instead."""
    if ',' in limit:
        patterns = limit.split(',')
    elif (
        '::' in limit
        or LIMIT_HOSTPORT.match(limit)
        # uncompressed, also with an IPv4 part (`0:0:0:0:0:ffff:192.0.2.1`)
        or (LIMIT_IPV6.match(limit) and limit.count(':') >= 6)
    ):
        return None
    else:
        patterns = LIMIT_COLON_SPLIT.findall(limit)
    return [p.strip() for p in patterns if p.strip()]


def _match_pattern(pattern, groups):
    """The hosts of the groups matching the pattern, plus the hosts matching it if no
    group does or if it is a glob, like _enumerate_matches(). None if not supported."""
    if not pattern or pattern[0] in '@~' or LIMIT_SUBSCRIPT.match(pattern):
        return None
    regex = re.compile(fnmatch.translate(pattern))
    matching = [g for g in groups if regex.match(g)]
    result = set().union(*(groups[g] for g in matching))
    if not matching or any(c in pattern for c in '.?*['):
        result |= {h for h in groups['all'] if regex.match(h)}
    return result


def resolve_limit(limit, groups):
    """The hosts of `groups` (as merged_groups() returns them) that the `--limit` value
    selects, or None if the limit uses a pattern that is not supported."""
    patterns = split_limit(limit)
    if patterns is None:
        return None
    all_hosts = groups.get('all', set())
    # order_patterns(): the plain patterns first (`all` if there are none), then the
    # `&` ones, then the `!` ones
    ordered = [p for p in patterns if p[0] not in '&!'] or ['all']
    ordered += [p for p in patterns if p[0] == '&']
    ordered += [p for p in patterns if p[0] == '!']
    result = set()
    for pattern in ordered:
        # a plain host name is taken as is, even if a group has the same name
        if pattern in all_hosts:
            result.add(pattern)
            continue
        expr = pattern[1:] if pattern[0] in '&!' else pattern
        matched = _match_pattern(expr, groups)
        if matched is None:
            return None
        if pattern[0] == '&':
            result &= matched
        elif pattern[0] == '!':
            result -= matched
        else:
            result |= matched
    return result


# --- terminal UI -----------------------------------------------------------------------


class Back(Exception):
    pass


class Recall(Exception):
    """Ctrl-R, to choose a past run."""


class Item:
    def __init__(self, value, label=None, desc='', marker=''):
        self.value = value
        self.label = label if label is not None else value
        self.desc = desc
        self.marker = marker


def _is_subsequence(query, text):
    """True if the characters of `query` appear in `text` in that order, for example
    `setbas` in `setup_basic`."""
    chars = iter(text)
    return all(c in chars for c in query)


def _filter(items, query):
    """Entries whose label contains the query (or matches it as a glob) come first,
    followed by the ones that contain its characters in order, and the ones that
    contain it in their description only."""
    query = query.lower()
    if not query:
        return list(items)
    if any(c in query for c in '*?['):
        return [i for i in items if fnmatch.fnmatch(i.label.lower(), query)]
    exact = [i for i in items if query == i.label.lower()]
    in_label = [i for i in items if query in i.label.lower() and i not in exact]
    fuzzy = [
        i
        for i in items
        if query not in i.label.lower() and _is_subsequence(query, i.label.lower())
    ]
    in_desc = [
        i
        for i in items
        if not _is_subsequence(query, i.label.lower()) and query in i.desc.lower()
    ]
    return exact + in_label + fuzzy + in_desc


def _known(values, items):
    """The values that are among the items, to preselect them."""
    known = {i.value for i in items}
    return [v for v in values if v in known]


def _addstr(win, y, x, text, attr=0):
    height, width = win.getmaxyx()
    if y >= height or x >= width:
        return
    try:
        win.addnstr(y, x, text, width - x - 1, attr)
    except curses.error:
        pass


def _addruns(win, y, runs, attr=0, x=0):
    """Draws (text, attr) runs side by side on line `y` from column `x`, `attr` added
    to each."""
    for text, run_attr in runs:
        _addstr(win, y, x, text, run_attr | attr)
        x += len(text)


# set by init_colors(), in the colors of the dashboard callback
ACCENT = curses.A_BOLD  # what the current page sets in the command
ALERT = curses.A_REVERSE  # a command that runs on no host
CHECK = curses.A_BOLD  # the confirm page: a run with --check
LABEL = 0  # markers such as "recent" and "group"
LIVE = curses.A_BOLD | curses.A_REVERSE  # the confirm page: a run without --check
WARN = curses.A_BOLD  # the confirm page: a selection worth a second look
RULE = '─' if 'utf' in locale.getpreferredencoding(False).lower() else '-'
STEPS = ('playbook', 'tags', 'inventories', 'limit', 'confirm')


def init_colors():
    global ACCENT, ALERT, CHECK, LABEL, LIVE, WARN
    try:
        curses.use_default_colors()
        background = -1  # keep the colors of the terminal
    except curses.error:
        background = curses.COLOR_BLACK
    if not curses.has_colors():
        return
    try:
        curses.init_pair(1, curses.COLOR_GREEN, background)
        curses.init_pair(2, curses.COLOR_BLUE, background)
        curses.init_pair(3, curses.COLOR_RED, background)
        curses.init_pair(4, curses.COLOR_YELLOW, background)
    except curses.error:
        return
    ACCENT = curses.color_pair(1) | curses.A_BOLD
    LABEL = curses.color_pair(2)
    ALERT = curses.color_pair(3) | curses.A_BOLD
    CHECK = ACCENT
    LIVE = ALERT | curses.A_REVERSE
    WARN = curses.color_pair(4) | curses.A_BOLD


def display_arg(arg):
    """An argument as the pages show it: shell-quoted, an inventory below $LF_GITLAB
    relative to it, as the inventory step lists it. Both are the same to bash."""
    base = os.environ.get('LF_GITLAB', '')
    if base and arg.startswith(f'--inventory={base.rstrip("/")}/'):
        path = os.path.relpath(arg[len('--inventory=') :], base)
        if shlex.quote(path) == path:
            return f'--inventory=$LF_GITLAB/{path}'
    return shlex.quote(arg)


def command_lines(parts, part, width):
    """The command as lines of at most `width` characters, continued with ` \\`, each a
    list of (text, attr) runs. The arguments that `part` sets are highlighted."""
    lines, line, used = [], [('$ ', curses.A_DIM)], 2
    for arg, key in parts:
        text = display_arg(arg)
        if len(line) > 1 and used + 1 + len(text) + 2 > width:
            lines.append([*line, (' \\', curses.A_DIM)])
            line, used = [('    ', 0)], 4
        elif len(line) > 1:
            line.append((' ', 0))
            used += 1
        line.append((text, ACCENT if part and key == part else 0))
        used += len(text)
    return [*lines, line]


class Header:
    """The frame of a page, in the style of the dashboard callback. On top the bold
    title with the number of targeted hosts on the right, the LFOps checkout, the steps
    as a bar and a rule. At the bottom, above the two lines of status and keys, a rule
    and the command as it stands with the selection of the page. The command sits at
    the bottom so that the list does not move when it grows by a line.

    `preview` turns the values Enter would take into the state they lead to, `part` is
    the EMPTY_STATE key the page sets, `hosts` returns the right side for a state.
    The command takes up to 1/`room` of the lines. Without `command`, the header leaves
    it out, for a page that shows the command itself."""

    def __init__(
        self,
        title,
        origin,
        step=None,
        preview=None,
        part=None,
        hosts=None,
        room=3,
        command=True,
    ):
        self.hosts = hosts
        self.origin = origin
        self.part = part
        self.preview = preview
        self.room = room
        self.step = step
        self.command = command
        self.title = title

    def draw(self, win, values=()):
        """Draws the frame. Returns the first and the last line free between the
        rules."""
        height, width = win.getmaxyx()
        width -= 1
        state = self.preview(values) if self.preview else None
        right = self.hosts(state) if self.hosts and state else ''
        gap = ' ' * max(width - len(self.title) - len(right), 1)
        _addruns(win, 0, [(self.title, curses.A_BOLD), (gap + right, 0)])
        _addstr(win, 1, 0, self.origin, curses.A_DIM)
        top = 2
        if self.step is not None:
            label = f' step {self.step + 1}/{len(STEPS)}   ' + ' > '.join(STEPS)
            line = label.ljust(width)[:width]
            done = width * (self.step + 1) // len(STEPS)
            _addruns(win, top, [(line[:done], curses.A_REVERSE), (line[done:], 0)])
            top += 1
        _addstr(win, top, 0, RULE * width, curses.A_DIM)
        lines = []
        if state and self.command:
            lines = command_lines(command_parts(state), self.part, width)
            room = max(1, height // self.room)
            if len(lines) > room:
                lines = [*lines[: room - 1], [('    ...', curses.A_DIM)]]
        bottom = height - 3 - len(lines)  # the lower rule
        _addstr(win, bottom, 0, RULE * width, curses.A_DIM)
        for row, line in enumerate(lines, start=bottom + 1):
            _addruns(win, row, line)
        return top + 1, bottom - 1


def _chosen(selected, visible, cursor, query, typed):
    """The values Enter takes: the selection, plus the typed text on the entry of its
    own, else the highlighted entry."""
    if typed and query and cursor == 0 and query not in selected:
        return [v for v in selected if v is not None] + [query]
    if selected:
        return selected
    if visible:
        return [visible[cursor].value]
    return []


def pick(
    stdscr,
    header,
    items,
    multi,
    context='',
    typed=None,
    preselect=(),
    recall=True,
):
    """Shows a filterable list below the Header `header`. Returns the list of selected
    values; raises Back on Esc. The dim context follows the header.

    Without a selection, Enter takes the highlighted entry. Without `multi`, Space and
    Tab do the same. The entry with the value None ("no --tags", "no --limit") excludes
    all others. With `typed`, a (marker, description) pair, the typed filter is offered
    as an entry of its own, for example as pattern for `--limit`; Enter on it adds it to
    the selection. `preselect` are the values selected at the start. Ctrl-R raises
    Recall, unless `recall` is False."""
    query, cursor, top = '', 0, 0
    selected = list(preselect)  # values, in the order they were selected
    while True:
        visible = _filter(items, query)
        if typed and query:
            visible.insert(0, Item(query, query, typed[1], marker=typed[0]))
        height, width = stdscr.getmaxyx()
        cursor = max(0, min(cursor, len(visible) - 1))

        stdscr.erase()
        query_row, last = header.draw(
            stdscr, _chosen(selected, visible, cursor, query, typed)
        )
        if context:
            _addstr(stdscr, query_row, 0, context, curses.A_DIM)
            query_row += 1
        rows = max(1, last - query_row)
        top = min(max(top, cursor - rows + 1), cursor)
        _addstr(stdscr, query_row, 0, f'> {query}')
        label_width = min(
            max([len(i.label) + len(i.marker) + 3 for i in visible] + [10]) + 2,
            max(20, width // 2),
        )
        for row, item in enumerate(visible[top : top + rows]):
            index = top + row
            attr = curses.A_REVERSE if index == cursor else 0
            check = ''
            if multi:
                check = '[x] ' if item.value in selected else '[ ] '
            marker = f'({item.marker}) ' if item.marker else ''
            label = item.label.ljust(label_width - len(marker))
            runs = [(check, 0), (marker, LABEL), (label, 0), (f' {item.desc}', 0)]
            if index != cursor:
                runs[-1] = (runs[-1][0], curses.A_DIM)
            _addruns(stdscr, query_row + 1 + row, runs, attr)
        status = f'{len(visible)}/{len(items)}'
        if multi:
            status += f', {len(selected)} selected'
        if recall:
            status += '   Ctrl-R: past runs'
        keys = 'Esc: back   Ctrl-C: quit'
        if multi:
            keys = 'Space: select   Ctrl-A: all visible   Enter: continue   ' + keys
        else:
            keys = 'Enter/Space: continue   ' + keys
        _addstr(stdscr, height - 2, 0, status, curses.A_DIM)
        _addstr(stdscr, height - 1, 0, keys, curses.A_DIM)
        stdscr.move(query_row, min(2 + len(query), width - 1))
        stdscr.refresh()

        key = stdscr.get_wch()
        if key == curses.KEY_RESIZE:
            continue
        if key in ('\x1b',):
            raise Back
        if key in ('\n', '\r', curses.KEY_ENTER) or (not multi and key in (' ', '\t')):
            # typed text is meant to be used, even next to a selection
            chosen = _chosen(selected, visible, cursor, query, typed)
            if chosen:
                return chosen
            continue
        if key == curses.KEY_UP:
            cursor -= 1
        elif key == curses.KEY_DOWN:
            cursor += 1
        elif key == curses.KEY_PPAGE:
            cursor -= rows
        elif key == curses.KEY_NPAGE:
            cursor += rows
        elif key == curses.KEY_HOME:
            cursor = 0
        elif key == curses.KEY_END:
            cursor = len(visible) - 1
        elif key in (curses.KEY_BACKSPACE, '\x7f', '\b'):
            query, cursor = query[:-1], 0
        elif key == '\x12' and recall:  # Ctrl-R
            raise Recall
        elif key == '\x15':  # Ctrl-U
            query, cursor = '', 0
        elif multi and key in (' ', '\t') and visible:
            value = visible[cursor].value
            if value in selected:
                selected.remove(value)
            elif value is None:
                selected = [None]
            else:
                selected = [v for v in selected if v is not None] + [value]
            cursor += 1
        elif multi and key == '\x01':  # Ctrl-A
            values = [i.value for i in visible if i.value is not None]
            selected = [v for v in selected if v is not None]
            if all(v in selected for v in values):
                selected = [v for v in selected if v not in values]
            else:
                selected += [v for v in values if v not in selected]
        elif isinstance(key, str) and key.isprintable() and key != ' ':
            query, cursor = query + key, 0


def _addch(win, y, x, char):
    try:
        win.addch(y, x, char)
    except curses.error:
        pass  # the bottom right cell of a window, the character is drawn anyway


def draw_box(win, y, x, size, box):
    """Draws a box with a frame. `size` is (height, width), `box` a dict with `title`,
    `lines` and optionally `title_attr` and a `footer` (text, attr) on the bottom frame.
    A line is either a list of (text, attr) runs or a (text, attr, right text, right
    attr) tuple, the right text aligned to the right edge."""
    height, width = size
    if height < 2 or width < 4:
        return
    bottom, right = y + height - 1, x + width - 1
    win.hline(y, x + 1, curses.ACS_HLINE, width - 2)
    win.hline(bottom, x + 1, curses.ACS_HLINE, width - 2)
    if height > 2:
        win.vline(y + 1, x, curses.ACS_VLINE, height - 2)
        win.vline(y + 1, right, curses.ACS_VLINE, height - 2)
    _addch(win, y, x, curses.ACS_ULCORNER)
    _addch(win, y, right, curses.ACS_URCORNER)
    _addch(win, bottom, x, curses.ACS_LLCORNER)
    _addch(win, bottom, right, curses.ACS_LRCORNER)
    win.addnstr(
        y, x + 2, f' {box["title"]} ', max(0, width - 4), box.get('title_attr', 0)
    )
    if box.get('footer'):
        text, attr = box['footer']
        text = f' {text} '[: max(0, width - 4)]
        win.addnstr(bottom, right - 1 - len(text), text, len(text), attr)
    inner = width - 4
    for row, line in enumerate(box['lines'][: height - 2], start=y + 1):
        if isinstance(line, list):
            _addruns(win, row, line, x=x + 2)
            continue
        text, attr, right_text, right_attr = line
        room = inner
        if right_text and len(right_text) < inner:
            room = inner - len(right_text) - 1
            win.addnstr(row, right - 1 - len(right_text), right_text, inner, right_attr)
        if len(text) > room:
            text = text[: max(0, room - 3)] + '...'
        win.addnstr(row, x + 2, text, max(0, room), attr)


def wrap_runs(lines, width):
    """Lines of (text, attr) runs, a line longer than `width` wrapped onto further
    lines instead of cut: the command is the authoritative part of the confirm page."""
    indent = '        '

    def wrap(line, room):
        result, current, used = [], [], 0
        for text, attr in line:
            while used + len(text) > room:
                take = max(1, room - used)
                current.append((text[:take], attr))
                result.append(current)
                current, used = [(indent, 0)], len(indent)
                text = text[take:]
            current.append((text, attr))
            used += len(text)
        return [*result, current]

    result = []
    for line in lines:
        # the ` \` at the end goes with the last characters, not on a line of its own
        tail = line[-1:] if line and line[-1][0] == ' \\' else []
        wrapped = wrap(line[: len(line) - len(tail)], width)
        if tail and sum(len(t) for t, _ in wrapped[-1]) + len(tail[0][0]) > width:
            wrapped[-1:] = wrap(wrapped[-1], width - len(tail[0][0]))
        result += [*wrapped[:-1], wrapped[-1] + tail]
    return result


def host_columns(hosts, width, rows):
    """`hosts` in columns across `width`, at most `rows` lines. If they do not fit,
    the last line says how many are left out."""
    if not hosts or rows < 1:
        return []
    column = max(len(h) for h in hosts) + 3
    per_line = max(1, width // column)
    needed = -(-len(hosts) // per_line)
    shown = hosts if needed <= rows else hosts[: (rows - 1) * per_line]
    lines = [
        (''.join(h.ljust(column) for h in shown[i : i + per_line]), 0, '', 0)
        for i in range(0, len(shown), per_line)
    ]
    if len(shown) < len(hosts):
        lines.append((f'... and {len(hosts) - len(shown)} more', curses.A_DIM, '', 0))
    return lines


def inventory_label(inventory):
    base = os.environ.get('LF_GITLAB', '')
    return os.path.relpath(inventory, base) if base else inventory


def unmatched(entry, groups, relevant):
    """The patterns of one entry of the limit that match none of the relevant hosts,
    for example a typo. With or without `&` and `!`, a pattern that matches nothing
    does nothing. Patterns this tool does not resolve are not reported."""
    result = []
    for pattern in split_limit(entry) or []:
        matched = resolve_limit(pattern.lstrip('&!'), groups)
        if matched is not None and not matched & relevant:
            result.append(pattern)
    return result


def summary(discovery, state):
    """The boxes of the confirm page above the command, as dicts for draw_box()."""

    def line(text, attr=0, right='', right_attr=0):
        return (text, attr, right, right_attr)

    relevant = relevant_hosts(discovery, state)
    groups = discovery.groups(state['inventories'])
    playbook = [line(f'linuxfabrik.lfops.{state["playbook"]}')]
    if state['role']:
        playbook.append(
            line(f'selected {state["role"]}, runs as part of {state["playbook"]}', WARN)
        )
    inventories = []
    for inventory in state['inventories']:
        count = len(relevant_hosts(discovery, {**state, 'inventories': [inventory]}))
        inventories.append(
            line(
                inventory_label(inventory),
                right=plural(count, 'host'),
                right_attr=0 if count else WARN,
            )
        )
    limits = []
    for entry in state['limits']:
        missing = unmatched(entry, groups, relevant)
        # name the pattern if the entry holds several, like `a,b`
        hint = 'matches no host' if missing == [entry] else ''
        if missing and not hint:
            hint = f'{", ".join(missing)} matches no host'
        limits.append(line(entry, 0, hint, WARN))
    limits = limits or [line(f'(none, all {plural(len(relevant), "host")})', WARN)]
    tags = [line(tag) for tag in state['tags']] or [
        line('(none, whole playbook)', curses.A_DIM)
    ]
    options = [line(option) for option in state['options']] or [
        line('(none)', curses.A_DIM)
    ]

    targets = targeted_hosts(discovery, state)
    if targets is None:
        hosts = {
            'title': 'Hosts targeted: unknown',
            'title_attr': WARN,
            'notes': [
                line(
                    'the limit uses a pattern this tool does not resolve', curses.A_DIM
                ),
                line('(~regex, @file, [subscript], host:port, IPv6, ::)', curses.A_DIM),
            ],
        }
    elif not targets:
        hosts = {
            'title': '0 hosts targeted, Ansible would run nothing',
            'title_attr': ALERT,
            'notes': [
                line(
                    'the limit matches none of the hosts of the playbook', curses.A_DIM
                )
            ],
        }
    else:
        hosts = {
            'title': f'Hosts targeted (estimate): {len(targets)}',
            'title_attr': curses.A_BOLD,
        }
    hosts['hosts'] = sorted(targets or [])

    def box(title, lines):
        return {'title': title, 'title_attr': curses.A_BOLD, 'lines': lines}

    return {
        'hosts': hosts,
        'inventories': box('Inventories', inventories),
        'limit': box('Limit', limits),
        'options': box('Options', options),
        'playbook': box('Playbook', playbook),
        'tags': box('Tags', tags),
    }


# side by side boxes need this many columns, below they are stacked
SIDE_BY_SIDE_MIN_WIDTH = 72


def confirm(stdscr, header, state, boxes):
    """Shows the Header `header`, the boxes of summary() and, right below them, the
    command of `state`. Returns 'run' on Enter, the option to switch on `c` and `d`,
    'options' on `o` and 'recall' on Ctrl-R; raises Back on Esc.

    The command is never cut. On a short terminal, it sticks to the bottom, the host
    list shrinks first, after that the boxes above the command scroll."""
    keys = {'c': '--check', 'd': '--diff', 'o': 'options', '\x12': 'recall'}
    scroll = 0
    while True:
        height, width = stdscr.getmaxyx()
        width -= 1  # like the rules of the header
        stdscr.erase()
        start, last = header.draw(stdscr)
        command = wrap_runs(
            command_lines(command_parts(state), 'options', width - 4), width - 4
        )
        # the lowest line the command box can start on and still fit completely
        lowest_top = last + 1 - (len(command) + 2)
        if lowest_top < start or width < 20:
            stdscr.erase()
            _addstr(stdscr, 0, 0, 'The terminal is too small to show the command.')
            _addstr(stdscr, 1, 0, 'Enlarge it, or Esc: back   Ctrl-C: quit')
            stdscr.refresh()
            if stdscr.get_wch() == '\x1b':
                raise Back
            continue

        rows = [[boxes['playbook']]]
        pairs = [
            [boxes['inventories'], boxes['limit']],
            [boxes['tags'], boxes['options']],
        ]
        for pair in pairs:
            rows += [pair] if width >= SIDE_BY_SIDE_MIN_WIDTH else [[b] for b in pair]
        fixed = sum(max(len(b['lines']) for b in row) + 2 for row in rows)
        middle = lowest_top - start  # lines the boxes can take without scrolling
        hosts = boxes['hosts']
        # once the boxes scroll anyway, a shorter host list gains nothing
        host_rows = middle - fixed - 2
        host_lines = hosts.get('notes', []) or host_columns(
            hosts['hosts'],
            width - 4,
            host_rows if host_rows > 0 else len(hosts['hosts']),
        )
        total = fixed + len(host_lines) + 2
        scroll = max(0, min(scroll, total - middle))
        command_top = min(start + total, lowest_top)

        pad = curses.newpad(total, width + 1)
        y = 0
        for row in rows:
            box_height = max(len(b['lines']) for b in row) + 2
            x = 0
            for index, box in enumerate(row):
                box_width = width // len(row)
                if index == len(row) - 1:
                    box_width = width - x
                draw_box(pad, y, x, (box_height, box_width), box)
                x += box_width
            y += box_height
        draw_box(
            pad, y, 0, (len(host_lines) + 2, width), {**hosts, 'lines': host_lines}
        )
        draw_box(
            stdscr,
            command_top,
            0,
            (len(command) + 2, width),
            {
                'title': 'Command',
                'title_attr': curses.A_BOLD,
                'lines': command,
                # on the command box, so it is always visible
                'footer': ('CHECK MODE', CHECK)
                if '--check' in state['options']
                else ('LIVE RUN', LIVE),
            },
        )
        hint = 'Ctrl-R: past runs'
        if total > middle:
            hint += '   Up/Down/PgUp/PgDn: scroll'
        _addstr(stdscr, height - 2, 0, hint, curses.A_DIM)
        _addstr(
            stdscr,
            height - 1,
            0,
            'c: --check   d: --diff   o: options   '
            'Enter: run   Esc: back   Ctrl-C: quit',
            curses.A_DIM,
        )
        curses.curs_set(0)
        stdscr.noutrefresh()
        if middle > 0:
            shown = min(middle, total - scroll)
            pad.noutrefresh(scroll, 0, start, 0, start + shown - 1, width)
        curses.doupdate()
        key = stdscr.get_wch()
        curses.curs_set(1)
        if key in ('\n', '\r', curses.KEY_ENTER):
            return 'run'
        if key == '\x1b':
            raise Back
        if key in keys:
            return keys[key]
        scroll += {
            curses.KEY_DOWN: 1,
            curses.KEY_NPAGE: max(1, middle),
            curses.KEY_PPAGE: -max(1, middle),
            curses.KEY_UP: -1,
        }.get(key, 0)


# --- steps -----------------------------------------------------------------------------


def command_parts(state):
    """The arguments of the command as (argument, key) pairs, the key being the
    EMPTY_STATE entry the argument comes from. Without a playbook, the command ends
    after `run`."""
    parts = [('ansible-navigator', None), ('run', None)]
    if state['playbook']:
        parts.append((f'linuxfabrik.lfops.{state["playbook"]}', 'playbook'))
    parts += [(f'--inventory={i}', 'inventories') for i in state['inventories']]
    if state['tags']:
        parts.append((f'--tags={",".join(state["tags"])}', 'tags'))
    if state['limits']:
        parts.append((f'--limit={",".join(state["limits"])}', 'limits'))
    return parts + [(option, 'options') for option in state['options']]


def build_command(state):
    return [arg for arg, _ in command_parts(state)]


# short options of ansible-navigator run whose long form `c`, `d` and `o` know
OPTION_ALIASES = {'-C': '--check', '-D': '--diff', '-e': '--extra-vars'}


def tool_options(args):
    """The arguments given to the tool itself, one entry per option: `-C` becomes
    `--check`, `--extra-vars x=y` and `-e x=y` become `--extra-vars=x=y`, so `c`, `d`
    and `o` switch them as a whole."""
    options = []
    for arg in args:
        last = options[-1] if options else ''
        takes_value = last.startswith('--') and '=' not in last and last not in OPTIONS
        if takes_value and not arg.startswith('-'):
            options[-1] = f'{last}={arg}'
        else:
            options.append(OPTION_ALIASES.get(arg, arg))
    return options


def toggle(values, value):
    """`values` with `value` removed if it is in there, else appended."""
    if value in values:
        return [v for v in values if v != value]
    return [*values, value]


def run_items(discovery, history):
    """The past runs whose playbook and inventories still exist, used last first.
    The value is the index in history['runs']."""
    base = os.environ.get('LF_GITLAB', '')
    items = []
    for index, run in enumerate(history['runs']):
        run = {**EMPTY_STATE, **run}
        if run['playbook'] not in discovery.playbooks or not all(
            i in discovery.inventories for i in run['inventories']
        ):
            continue
        short = [os.path.relpath(i, base) if base else i for i in run['inventories']]
        command = build_command({**run, 'inventories': short})
        when = time.strftime('%Y-%m-%d %H:%M', time.localtime(run.get('time', 0)))
        items.append(Item(index, f'{when}  {shlex.join(command[2:])}'))
    return items


def option_items(options, history):
    """The known options, the ones used before and the selected ones, used last first."""
    used = history['options']
    values = list(dict.fromkeys([*OPTIONS, *options, *used]))
    items = [Item(None, '(no further options)', 'run without options')]
    return items + [
        Item(v, v, OPTIONS.get(v, ''), 'recent' if v in used else '')
        for v in by_recency(values, used)
    ]


def tag_items(lfops_dir, playbook, history):
    roles, _ = playbook_info(lfops_dir, playbook)
    tags = {}
    for role in roles:
        for tag, desc in role_tags(lfops_dir, role):
            tags.setdefault(tag, desc)
    tags.setdefault(
        'all', 'all tasks that run by default, combine with an explicit tag'
    )
    used = history['tags'].get(playbook, {})
    order = by_recency(list(tags), used)
    items = [Item(None, '(no --tags)', 'run the whole playbook')]
    return items + [
        Item(tag, tag, tags[tag], 'recent' if tag in used else '') for tag in order
    ]


class Discovery:
    """Playbooks and inventories, parsed once per run."""

    def __init__(self, lfops_dir):
        self.lfops_dir = lfops_dir
        self.plays = {
            p: playbook_plays(lfops_dir, p) for p in list_playbooks(lfops_dir)
        }
        self.playbooks = {p: playbook_info(lfops_dir, p) for p in self.plays}
        self.inventories = {i: Inventory(i) for i in list_inventories()}
        self._groups = {}
        self._tags = {}

    def groups(self, inventories):
        """merged_groups() of the inventories (paths), cached."""
        key = tuple(inventories)
        if key not in self._groups:
            self._groups[key] = merged_groups(self.inventories[i] for i in key)
        return self._groups[key]

    def hosts(self, playbook, inventories):
        """The hosts of the inventories that a playbook runs against."""
        groups = self.groups(inventories)
        result = set()
        for target in self.playbooks[playbook][1]:
            result |= groups.get(target, set())
        return result

    def role_hosts(self, playbook, role, inventories):
        """The hosts of the inventories on which a playbook runs a role. In `all`, for
        example, the squid role only runs on the hosts of `lfops_squid`, and in
        `setup_basic`, `setup_basic__skip_aide: true` skips the aide role."""
        groups = self.groups(inventories)
        invs = [self.inventories[i] for i in inventories]
        result = set()
        for targets, roles, skips in self.plays[playbook]:
            if role not in roles:
                continue
            for target in targets:
                for host in groups.get(target, set()):
                    if not self._skipped(invs, host, skips.get(role, [frozenset()])):
                        result.add(host)
        return result

    @staticmethod
    def _skipped(invs, host, occurrences):
        """True if every occurrence of the role is skipped on the host. The value of a
        skip variable comes from the last inventory that sets it, each inventory looked
        up on its own. Only a literal `true` counts, a Jinja expression is taken as not
        skipping."""

        def is_true(var):
            for inv in reversed(invs):
                try:
                    return inv.value(host, var) is True
                except KeyError:
                    pass
            return False

        return all(any(is_true(var) for var in skip) for skip in occurrences)

    def has_tag(self, role, tag):
        if role not in self._tags:
            self._tags[role] = {t for t, _ in role_tags(self.lfops_dir, role)}
        return tag in self._tags[role]

    def parent(self, playbook, inventories, history):
        """A playbook that runs the role of `playbook` on hosts of all `inventories`,
        with the role name as tag. For example `monitoring_plugins`, which runs as part
        of `setup_basic` on most hosts. Prefers the one used last, then the one with the
        fewest roles."""
        if not self.has_tag(playbook, playbook):
            return None
        candidates = [
            p
            for p, (roles, _) in self.playbooks.items()
            if p != playbook
            and playbook in roles
            and all(self.role_hosts(p, playbook, [i]) for i in inventories)
        ]
        candidates.sort(key=lambda p: len(self.playbooks[p][0]))
        return next(iter(by_recency(candidates, history['playbooks'])), None)


def playbook_items(discovery, history):
    runnable = []
    for playbook in discovery.playbooks:
        counts = [len(discovery.hosts(playbook, [i])) for i in discovery.inventories]
        inventories = sum(1 for c in counts if c)
        if inventories:
            desc = (
                f'{plural(sum(counts), "host")} in '
                f'{inventories} inventor{"y" if inventories == 1 else "ies"}'
            )
            runnable.append(Item(playbook, playbook, desc))
    for item in runnable:
        if item.value in history['playbooks']:
            item.marker = 'recent'
    order = by_recency([i.value for i in runnable], history['playbooks'])
    by_value = {i.value: i for i in runnable}
    return [by_value[v] for v in order]


def inventory_items(discovery, playbook, history):
    runnable, other = [], []
    for inventory in by_recency(list(discovery.inventories), history['inventories']):
        label = inventory_label(inventory)
        hosts = discovery.hosts(playbook, [inventory])
        if hosts:
            marker = 'recent' if inventory in history['inventories'] else ''
            runnable.append(Item(inventory, label, plural(len(hosts), 'host'), marker))
            continue
        parent = discovery.parent(playbook, [inventory], history)
        if parent:
            desc = f'no hosts for {playbook}, runs {parent} --tags={playbook}'
            other.append(Item(inventory, label, desc, f'via {parent}'))
    return runnable + other


def relevant_hosts(discovery, state):
    """The hosts of the selected inventories that the playbook runs against, or, when
    running a role via a parent playbook, the hosts it runs the role on. Computed on
    the merged group structure of the inventories, like Ansible does."""
    if state['role']:
        return discovery.role_hosts(
            state['playbook'], state['role'], state['inventories']
        )
    return discovery.hosts(state['playbook'], state['inventories'])


def targeted_hosts(discovery, state):
    """The relevant hosts the limit selects, None if the limit cannot be resolved.
    An estimate, see resolve_limit()."""
    relevant = relevant_hosts(discovery, state)
    if not state['limits']:
        return relevant
    groups = discovery.groups(state['inventories'])
    # one --limit value, as build_command() passes it
    selected = resolve_limit(','.join(state['limits']), groups)
    return None if selected is None else relevant & selected


def limit_items(discovery, state, history):
    groups = discovery.groups(state['inventories'])
    relevant = relevant_hosts(discovery, state)
    targets = discovery.playbooks[state['playbook']][1]
    hint = f'hosts of {", ".join(targets)}'
    used = {}
    for inventory in state['inventories']:
        used.update(history['limits'].get(inventory, {}))
    group_names = sorted(g for g, h in groups.items() if h & relevant and g != 'all')
    values = sorted(relevant) + group_names
    recent = [v for v in by_recency(values, used) if v in used]
    recent += sorted(v for v in used if v not in values)  # patterns used before

    def desc(value):
        if value in group_names:
            return plural(len(groups[value] & relevant), 'host')
        return ''

    # entries used before are listed once, on top
    items = [Item(None, '(no --limit)', f'all {plural(len(relevant), "host")}')]
    items += [Item(v, v, desc(v), 'recent') for v in recent]
    items += [Item(h, h) for h in sorted(relevant) if h not in used]
    items += [Item(g, g, desc(g), 'group') for g in group_names if g not in used]
    return items, hint


def via_parent(discovery, state, inventories, history):
    """The state that runs the role of the playbook as part of a parent playbook, if
    the playbook has no hosts in all `inventories` and a parent has, else None."""
    playbook = state['playbook']
    if all(discovery.hosts(playbook, [i]) for i in inventories):
        return None
    parent = discovery.parent(playbook, inventories, history)
    if not parent:
        return None
    return {
        **state,
        'inventories': inventories,
        'note': f'{playbook} has no hosts in all selected inventories, '
        f'running it as part of {parent}',
        'playbook': parent,
        'requested': [playbook, state['tags']],
        'role': playbook,
        'tags': state['tags'] or [playbook],
    }


def run_ui(stdscr, lfops_dir, history, extra_args):
    init_colors()
    curses.curs_set(1)
    stdscr.keypad(True)
    discovery = Discovery(lfops_dir)
    if not discovery.inventories:
        raise SystemExit(f'lfops: no inventory matches {inventory_glob()}')
    origin = lfops_origin(lfops_dir)
    state = {**copy.deepcopy(EMPTY_STATE), 'options': tool_options(extra_args)}
    given_options = list(state['options'])  # arguments given to the tool itself
    step = 0

    def hosts(preview):
        """The right side of the header: the number of hosts the command targets."""
        if not preview['playbook'] or not preview['inventories']:
            return ''
        targets = targeted_hosts(discovery, preview)
        return 'hosts unknown' if targets is None else plural(len(targets), 'host')

    def header(title, part=None, preview=None, room=3, command=True):
        return Header(title, origin, step, preview, part, hosts, room, command)

    def with_playbook(values):
        if not values or values[0] == state['playbook']:
            return {**state, 'playbook': values[0] if values else state['playbook']}
        # the selections of the later steps belong to the playbook
        return {**EMPTY_STATE, 'options': state['options'], 'playbook': values[0]}

    def with_inventories(values):
        if not values:
            return state
        # limits of other inventories would stay selected unseen
        limits = state['limits'] if set(values) == set(state['inventories']) else []
        preview = {**state, 'limits': limits}
        return via_parent(discovery, preview, values, history) or {
            **preview,
            'inventories': values,
        }

    def without_none(key):
        return lambda values: {**state, key: [v for v in values if v is not None]}

    while True:
        try:
            if step == 0:
                items = playbook_items(discovery, history)
                if not items:
                    raise SystemExit('lfops: no playbook has hosts in any inventory')
                playbook = pick(
                    stdscr,
                    header('Choose a playbook', 'playbook', with_playbook),
                    items,
                    multi=False,
                )[0]
                state = with_playbook([playbook])
            elif step == 1:
                items = tag_items(lfops_dir, state['playbook'], history)
                tags = pick(
                    stdscr,
                    header(
                        f'Choose tags for linuxfabrik.lfops.{state["playbook"]}',
                        'tags',
                        without_none('tags'),
                    ),
                    items,
                    multi=True,
                    preselect=_known(state['tags'], items),
                )
                state['tags'] = [t for t in tags if t is not None]
            elif step == 2:
                if state['requested']:
                    state['playbook'], state['tags'] = state['requested']
                    state['requested'], state['note'], state['role'] = None, '', None
                playbook = state['playbook']
                items = inventory_items(discovery, playbook, history)
                if not items:
                    raise SystemExit(f'lfops: no inventory has hosts for {playbook}')
                context = f'inventories with hosts for {playbook}'
                attempt = state['inventories']
                while True:
                    inventories = pick(
                        stdscr,
                        header('Choose inventories', 'inventories', with_inventories),
                        items,
                        multi=True,
                        context=context,
                        preselect=_known(attempt, items),
                    )
                    if all(
                        discovery.hosts(playbook, [i]) for i in inventories
                    ) or via_parent(discovery, state, inventories, history):
                        state = with_inventories(inventories)
                        break
                    attempt = inventories
                    context = (
                        f'no playbook runs {playbook} on all selected inventories, '
                        'select fewer'
                    )
            elif step == 3:
                items, hint = limit_items(discovery, state, history)
                limits = pick(
                    stdscr,
                    header('Choose a limit', 'limits', without_none('limits')),
                    items,
                    multi=True,
                    context=state['note']
                    or hint + ' - type a glob like 060-t-* to use it as pattern',
                    typed=('pattern', 'use the typed text as pattern'),
                    preselect=state['limits'],  # may hold typed patterns
                )
                state['limits'] = [li for li in limits if li is not None]
            else:
                action = confirm(
                    stdscr,
                    header(
                        'Run this command?',
                        'options',
                        lambda _, run=state: run,
                        command=False,
                    ),
                    state,
                    summary(discovery, state),
                )
                if action == 'run':
                    return state, build_command(state)
                if action == 'recall':
                    raise Recall
                if action == 'options':
                    try:
                        options = pick(
                            stdscr,
                            header(
                                'Choose further options for ansible-navigator',
                                'options',
                                without_none('options'),
                            ),
                            option_items(state['options'], history),
                            recall=False,
                            multi=True,
                            context='type an argument such as --extra-vars=x=y '
                            'to use it as is, without spaces',
                            typed=('argument', 'pass the typed text on as is'),
                            preselect=state['options'],
                        )
                        state['options'] = [o for o in options if o is not None]
                    except Back:
                        pass
                else:
                    state['options'] = toggle(state['options'], action)
                continue
            step += 1
        except Back:
            if step == 0:
                return None, None
            step -= 1
        except Recall:
            items = run_items(discovery, history)
            try:
                index = pick(
                    stdscr,
                    Header(
                        'Choose a past run',
                        origin,
                        preview=lambda values: {
                            **EMPTY_STATE,
                            **(history['runs'][values[0]] if values else {}),
                        },
                        hosts=hosts,
                    ),
                    items,
                    multi=False,
                    context='fills in all steps and shows the confirm page'
                    if items
                    else 'no past runs yet',
                    recall=False,
                )[0]
            except Back:
                continue
            run = copy.deepcopy({**EMPTY_STATE, **history['runs'][index]})
            state = {key: run[key] for key in EMPTY_STATE}
            # arguments given to the tool itself still apply
            state['options'] += [o for o in given_options if o not in state['options']]
            step = 4


def print_shell_init(shell):
    """Prints the shell function for `shell`. It is named after the tool, so a link
    `lfo` to it defines `lfo`."""
    name = os.path.basename(sys.argv[0])
    if not FUNCTION_NAME.match(name):
        sys.exit(
            f'lfops: "{name}" is not usable as a shell function name, call the tool '
            'by a name of letters, digits, "_" and "-"'
        )
    print(SHELL_INIT[shell].replace('@NAME@', name), end='')


def main():
    parser = argparse.ArgumentParser(
        description=__doc__.split('\n\n', 1)[0],
        epilog='Further arguments are passed on to ansible-navigator.',
    )
    parser.add_argument(
        '--print-only',
        action='store_true',
        help='Print the command instead of running it. The terminal UI uses the '
        'terminal, so the output can be captured with `$(lfops --print-only)`.',
    )
    parser.add_argument(
        '--shell-init',
        choices=sorted(SHELL_INIT),
        metavar='SHELL',
        help='Print the shell function (bash or zsh) that '
        'puts the command on the prompt and into the history, for '
        '`eval "$(command lfops --shell-init bash)"` in ~/.bashrc or '
        '`eval "$(command lfops --shell-init zsh)"` in ~/.zshrc. The function is '
        'named after the tool, so a link `lfo` defines `lfo`.',
    )
    parser.add_argument('--version', action='version', version=__version__)
    # With `--print-only`, standard output is the command line: the shell function puts
    # it on the prompt. Help, version and shell function go to stderr there, so they
    # show up on the terminal and the function gets nothing.
    out = sys.stderr if '--print-only' in sys.argv[1:] else sys.stdout
    with contextlib.redirect_stdout(out):
        args, extra_args = parser.parse_known_args()
        if args.shell_init:
            print_shell_init(args.shell_init)
            return

    lfops_dir = find_lfops_dir()
    if not lfops_dir:
        sys.exit('lfops: LFOps not found, set LF_GITHUB or LFOPS_DIR')
    history = load_history()

    os.environ.setdefault('ESCDELAY', '25')
    # curses draws on stdout. With stdout captured by `$(lfops --print-only)`, draw on
    # the terminal and keep stdout for the command.
    stdout = None
    if not os.isatty(sys.stdout.fileno()):
        try:
            tty = os.open('/dev/tty', os.O_RDWR)
        except OSError:
            sys.exit('lfops: needs a terminal')
        sys.stdout.flush()
        stdout = os.dup(sys.stdout.fileno())
        os.dup2(tty, sys.stdout.fileno())
        os.close(tty)
    try:
        state, command = curses.wrapper(run_ui, lfops_dir, history, extra_args)
    except KeyboardInterrupt:
        sys.exit(130)
    finally:
        if stdout is not None:
            os.dup2(stdout, sys.stdout.fileno())
            os.close(stdout)
    if not command:
        sys.exit(0)

    save_history(history, state)
    print(shlex.join(command), flush=True)
    if args.print_only:
        return
    # ansible-navigator is a shell function in /etc/profile.d/alias.sh (pulls the
    # execution environment once a day), so start it through a login shell. Without
    # that function, the shell runs the ansible-navigator binary.
    os.execvp('bash', ['bash', '-lc', '"$@"', 'lfops', *command])  # nosec B606 B607


if __name__ == '__main__':
    main()

# Shell functions printed by `--shell-init`, `@NAME@` replaced by the name the tool
# is called by. `function NAME {` instead of `NAME() {`, because an alias of the same
# name would be expanded in the latter (bash: syntax error, zsh: "defining function
# based on alias"). Verified with bash 5.1.8 and zsh 5.8 on Rocky 9, bash 5.3.9 and
# zsh 5.9 on Fedora 44.
SHELL_INIT = {
    # `history -s` replaces the history entry of the call itself. `${PS1@P}` expands the
    # prompt (bash >= 4.4), `read -e` keeps the readline key bindings.
    'bash': r"""function @NAME@ {
    local cmd line
    cmd="$(command @NAME@ --print-only "$@")" || return
    [ -n "$cmd" ] || return 0
    history -s "$cmd"
    read -e -r -i "$cmd" -p "${PS1@P}" line || { echo; return 130; }
    [ -n "$line" ] || return 0
    [ "$line" = "$cmd" ] || history -s "$line"
    eval "$line"
}
""",
    # `print -z` pushes the command onto the line editor buffer: it shows up editable
    # on the next prompt, Enter runs it and adds it to the history, Ctrl-C drops it.
    # A zshaddhistory hook returning 1 keeps the call itself out of the history; it
    # lingers until the next line runs, so the command replaces it as in bash.
    # `emulate -L zsh` makes the functions independent of the options of the user (such
    # as `emulate sh` or `emulate ksh`), and no parentheses in the hook keep it parsable
    # with SH_GLOB set at eval time. `$1` is the line including the trailing newline.
    'zsh': r"""function @NAME@ {
    emulate -L zsh
    local cmd
    cmd="$(command @NAME@ --print-only "$@")" || return
    [[ -n $cmd ]] || return 0
    print -r -z -- "$cmd"
}
function _@NAME@_zshaddhistory {
    emulate -L zsh
    [[ ${1%%[[:space:]]*} != @NAME@ ]]
}
autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _@NAME@_zshaddhistory
""",
}
# a name that is safe as a shell function name and as a zsh pattern
FUNCTION_NAME = re.compile(r'^[A-Za-z_][A-Za-z0-9_-]*$')

ROLE_PREFIX = 'linuxfabrik.lfops.'

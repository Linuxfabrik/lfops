# `history -s` replaces the history entry of the `lfops` call itself. `${PS1@P}`
# expands the prompt (bash >= 4.4), `read -e` keeps the readline key bindings.
SHELL_INIT = r"""lfops() {
    local cmd line
    cmd="$(command lfops --print-only "$@")" || return
    [ -n "$cmd" ] || return 0
    history -s "$cmd"
    read -e -r -i "$cmd" -p "${PS1@P}" line || { echo; return 130; }
    [ -n "$line" ] || return 0
    [ "$line" = "$cmd" ] || history -s "$line"
    eval "$line"
}
"""


# {{ ansible_managed }}
# 2026101601

# Based on the unit of the Debian package of the client, but with a static user instead of `DynamicUser=yes`, so that the client can run under an existing account such as `hnet`. The sandboxing that `DynamicUser=yes` implies is set explicitly.

[Unit]
After=network-online.target
Description=curaLINE Client
Wants=network-online.target

[Service]
CacheDirectory=swisscom-schweiz-ag/cdr-client
ConfigurationDirectory=swisscom-schweiz-ag/cdr-client
ConfigurationDirectoryMode=0750
# independent of the home of the user, so the client never writes into an existing home such as /home/hnet
Environment=HOME={{ __curaline__state_dir }}
ExecStart={{ __curaline__install_dir }}/bin/cdr-client-service
Group={{ curaline__group }}
LogsDirectory=swisscom-schweiz-ag/cdr-client
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
# the configuration directory is writable for `curaline__renew_credential`
ReadWritePaths={{ ([__curaline__install_dir, __curaline__config_dir] + __curaline__folders) | join(' ') }}
Restart=always
RestartSec=10s
RestrictSUIDSGID=yes
StateDirectory=swisscom-schweiz-ag/cdr-client
# the JVM exits with 143 on SIGTERM
SuccessExitStatus=143
SyslogIdentifier=cdr-client
Type=exec
User={{ curaline__user }}
WorkingDirectory={{ __curaline__install_dir }}

[Install]
WantedBy=multi-user.target

#jinja2:lstrip_blocks: True
#!/usr/bin/env bash

# {{ ansible_managed }}
# 2026102702

set -e

# make sure the backup is not readable by others
old_umask=$(umask)
umask 027

source /etc/mongodb-dump.conf

# the password of the dump user, kept out of the command line (and the process list). mongodump
# reads it with `--config`, mongosh in mongosh_eval().
login_file=/etc/mongodb-dump-login.json

auth_params=()
if [[ -n "${USERNAME:-}" ]]; then
    auth_params=(--authenticationDatabase "$AUTH_DATABASE" --username "$USERNAME")
fi

# run the JavaScript in $1 as the dump user. mongosh prompts for a password given without a
# value, so it logs in from the script; the user name comes through the environment instead of
# being quoted into the JavaScript.
function mongosh_eval() {
    local login_js=''
    if [[ -n "${USERNAME:-}" ]]; then
        login_js="
            const login = JSON.parse(require('fs').readFileSync('$login_file', 'utf8'));
            if (!db.getSiblingDB(process.env.MONGODB_DUMP_AUTH_DATABASE).auth(process.env.MONGODB_DUMP_USERNAME, login.password).ok) {
                throw new Error('authentication failed');
            }
        "
    fi
    MONGODB_DUMP_AUTH_DATABASE="${AUTH_DATABASE:-}" MONGODB_DUMP_USERNAME="${USERNAME:-}" \
        mongosh --quiet --host "$HOST" --port "$PORT" --eval "$login_js $1"
}

# make sure we can connect to server
if ! mongosh_eval 'db.getName()' &>/dev/null; then
    echo "Cannot connect to '$HOST:$PORT'" >&2
    exit 1
fi

{% if mongodb__dump_only_if_hidden %}
# only dump a hidden member of the replica set
if [[ "$(mongosh_eval 'print(db.hello().hidden === true)')" != 'true' ]]; then
    echo "Skipping, the instance is not hidden"
    exit 0
fi
{% endif %}

{% if mongodb__dump_method_mongodump %}
#
# Backup using mongodump
#

LOGFILE="$DUMP_BACKUP_DIR/mongodb-dump.log"

# remove old backups
rm -rf "$DUMP_BACKUP_DIR"
mkdir -p "$DUMP_BACKUP_DIR"

mongodump_params=(--host "$HOST" --port "$PORT" "${auth_params[@]}")
if [[ -n "${USERNAME:-}" ]]; then
    mongodump_params+=(--config "$login_file")
fi
{% if mongodb__dump_use_oplog %}
mongodump_params+=(--oplog)
{% endif %}

if ! mongodump "${mongodump_params[@]}" --out "$DUMP_BACKUP_DIR/temp" > "$LOGFILE" 2>&1; then
    echo "Error during mongodump. Have a look at $LOGFILE for details." >&2
    exit 1
fi

cd "$DUMP_BACKUP_DIR" 1> /dev/null
tar -cvzf "mongodb-dump.tar.gz" -C "$DUMP_BACKUP_DIR/temp/" . 1> /dev/null
rm -rf "$DUMP_BACKUP_DIR/temp/" 1> /dev/null

umask "$old_umask"
{% endif %}

{% if mongodb__dump_method_file_based %}
#
# File based backup (copies the data directory to the backup directory)
#

function unlock_instance() {
    if ! mongosh_eval 'db.fsyncUnlock()' > /dev/null; then
        echo 'failed to unlock the instance' >&2
        exit 3
    fi
}

# remove old backups
rm -rf "$FILE_BACKUP_DIR"
mkdir -p "$FILE_BACKUP_DIR"

# lock the instance. Abort if that fails: a copy of the data files of a running instance may not
# be restorable, and a failed unit is noticed, while a warning in the journal is not.
if ! mongosh_eval 'db.fsyncLock()' > /dev/null; then
    echo 'failed to lock the instance, no file based backup created' >&2
    exit 2
fi

# unlock also if the copy fails, otherwise `set -e` would leave the instance write-locked
trap unlock_instance EXIT

cp --archive --recursive "$DB_PATH" "$FILE_BACKUP_DIR"

trap - EXIT
unlock_instance
{% endif %}

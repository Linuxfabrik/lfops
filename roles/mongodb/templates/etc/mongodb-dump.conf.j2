# {{ ansible_managed }}
# 2026102901

HOST='127.0.0.1'
PORT='{{ mongodb__conf_net_port }}'

{% if mongodb__conf_security_authorization | bool and mongodb__dump_user is defined and mongodb__dump_user | length %}
# the password is in the systemd credential mongodb-dump-login.json
USERNAME='{{ mongodb__dump_user["username"] }}'
AUTH_DATABASE='{{ mongodb__dump_user["auth_database"] | default("admin") }}'
{% endif %}

DB_PATH='{{ __mongodb__db_path }}'
DUMP_BACKUP_DIR='{{ mongodb__dump_method_mongodump_backup_dir }}'
FILE_BACKUP_DIR='{{ mongodb__dump_method_file_based_backup_dir }}'

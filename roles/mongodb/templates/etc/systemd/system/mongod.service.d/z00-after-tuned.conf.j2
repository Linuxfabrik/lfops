# {{ ansible_managed }}
# 2026082701

# Order MongoDB after TuneD, so that the kernel settings this host depends on
# (transparent hugepages) are applied before mongod reads them. mongod checks
# transparent hugepages once at startup and warns for the rest of its runtime if
# they were still enabled at that point.
# tuned.service is Type=dbus and TuneD claims com.redhat.tuned only after it has
# applied the profile, so After= is enough. An ordering dependency on a unit
# that is not installed is ignored, so this drop-in is harmless without TuneD.

[Unit]
After=tuned.service

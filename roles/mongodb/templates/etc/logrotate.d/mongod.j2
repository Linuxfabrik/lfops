# {{ ansible_managed }}
# 2026103001

/var/log/mongodb/mongod.log
{
    compress
    daily
    dateext
    delaycompress
    missingok
    notifempty
    rotate 14
    postrotate
        if systemctl --quiet is-active mongod.service; then
            pkill --signal SIGUSR1 --exact mongod
        fi
    endscript
}

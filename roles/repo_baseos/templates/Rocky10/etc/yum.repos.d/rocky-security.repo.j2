# rocky-security.repo
#
# Unlike the upstream file, the security repositories use dl.rockylinux.org instead of
# the mirrorlist. The mirrors sync with a delay and every host is handed its own, so a
# hot-fix would reach part of the hosts hours later than the rest. dl.rockylinux.org
# answers with `Cache-Control: no-cache`, its caches revalidate every request against
# the origin. The upstream mirrorlist URL is kept as a comment.

[security]
name=Rocky Linux $releasever - Security
{% if repo_baseos__mirror_url is defined and repo_baseos__mirror_url | length and not (repo_baseos__security_repo_use_upstream | bool) %}
baseurl={{ repo_baseos__mirror_url }}/rocky/10/security/x86_64/os/
{% else %}
baseurl=https://dl.rockylinux.org/pub/rocky/10/security/$basearch/os/
{% endif %}
#mirrorlist=https://mirrors.rockylinux.org/mirrorlist?arch=$basearch&repo=security-$releasever$rltype
gpgcheck=1
enabled={{ repo_baseos__security_repo_enabled__combined_var | bool | ternary(1, 0) }}
countme=1
metadata_expire=6h
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-10
{% if repo_baseos__mirror_url is defined and repo_baseos__mirror_url | length and not (repo_baseos__security_repo_use_upstream | bool) and repo_baseos__basic_auth_login is defined and repo_baseos__basic_auth_login | length %}
username={{ repo_baseos__basic_auth_login["username"] }}
password={{ repo_baseos__basic_auth_login["password"] }}
{% endif %}

[security-debuginfo]
name=Rocky Linux $releasever - Security Debug
{% if repo_baseos__mirror_url is defined and repo_baseos__mirror_url | length and not (repo_baseos__security_repo_use_upstream | bool) %}
baseurl={{ repo_baseos__mirror_url }}/rocky/10/security/x86_64/debug/tree/
{% else %}
baseurl=https://dl.rockylinux.org/pub/rocky/10/security/$basearch/debug/tree/
{% endif %}
#mirrorlist=https://mirrors.rockylinux.org/mirrorlist?arch=$basearch&repo=security-$releasever-debug$rltype
gpgcheck=1
enabled=0
metadata_expire=6h
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-10
{% if repo_baseos__mirror_url is defined and repo_baseos__mirror_url | length and not (repo_baseos__security_repo_use_upstream | bool) and repo_baseos__basic_auth_login is defined and repo_baseos__basic_auth_login | length %}
username={{ repo_baseos__basic_auth_login["username"] }}
password={{ repo_baseos__basic_auth_login["password"] }}
{% endif %}


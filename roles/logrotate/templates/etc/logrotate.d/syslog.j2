# {{ ansible_managed }}
# 2022033101

/var/log/cron
/var/log/maillog
/var/log/messages
/var/log/secure
/var/log/spooler
{
    copytruncate
    daily
    dateext
    missingok
    rotate {{ logrotate__rotate }}
    sharedscripts
    postrotate
        /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}

#!/usr/bin/env bash
# {{ ansible_managed }}
# 2026091602
#
# Installs the latest minor release of the WordPress core in the installation directory given as
# the only argument. Each WordPress instance on the host has its own systemd service for it.
# The core belongs to root, so WordPress cannot update itself. Only the steps that do not load
# WordPress run as root; loading it executes code from wp-content, which the web server can
# write, so those steps run as apache.

set -o errexit -o nounset -o pipefail

if [ "$#" -ne 1 ] || [ ! -f "$1/wp-includes/version.php" ]; then
    echo "Usage: $(basename "$0") <WordPress installation directory>" >&2
    exit 2
fi
dir=$1

# --no-color: without the PHP posix extension, WP-CLI cannot tell that it does not write to a
# terminal and colours its output, which ends up as escape sequences in the journal

# does not load WordPress
current=$(/usr/local/bin/wp core version --no-color --path="$dir" --allow-root)
echo "WordPress $current installed in $dir."

# loads WordPress, therefore as apache
available=$(runuser --user=apache -- /usr/local/bin/wp core check-update --no-color --minor --field=version --path="$dir")
version=$(printf '%s\n' "$available" | grep --extended-regexp '^[0-9]+(\.[0-9]+)+$' | head --lines=1 || true)
if [ -z "$version" ]; then
    echo 'No minor release available, nothing to do.'
    exit 0
fi

echo "Updating WordPress from $current to $version."
# does not load WordPress; verifies the md5 checksum of the download
/usr/local/bin/wp core download --no-color --version="$version" --skip-content --force --path="$dir" --allow-root
# OPcache looks for changed files only every opcache.revalidate_freq seconds, so until then
# PHP-FPM would run old and new core files side by side. A reload lets running requests finish
# and starts the workers with an empty cache; a stopped PHP-FPM is left alone.
echo 'Reloading PHP-FPM, so that it drops the old core files from OPcache.'
systemctl try-reload-or-restart php-fpm.service
echo 'Updating the database.'
runuser --user=apache -- /usr/local/bin/wp core update-db --no-color --path="$dir"
echo 'Verifying the checksums of the core files.'
/usr/local/bin/wp core verify-checksums --no-color --path="$dir" --allow-root
echo "WordPress updated from $current to $version."

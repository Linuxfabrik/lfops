[Unit]
Description=WordPress Cron Service for {{ __wordpress__instance }}

[Service]
ExecStart=/usr/bin/curl http://localhost/wp-cron.php --header 'Host: {{ wordpress__url | regex_replace("^https?://", "") | regex_replace("[:/].*$", "") }}' --header 'X-Forwarded-Proto: {{ wordpress__url | urlsplit("scheme") }}'
Type=oneshot
User=root

[Install]
WantedBy=basic.target

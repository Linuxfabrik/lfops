# mod_http2
# This file and the http2 entry of `apache_httpd__mods__*_var` belong together: the H2* directives
# below are implemented by mod_http2 and abort the config test when it is not loaded. That is
# deliberate, a missing module has to be a startup error rather than silently dropped
# configuration. Disable both, or neither.

# `Protocols` is a core directive rather than a mod_http2 one, and protocol names that no loaded
# module implements are ignored. The list is the server's preference order: the leftmost protocol
# the client also offers wins, which is why h2 comes before http/1.1.
# h2 is HTTP/2 over TLS, h2c is HTTP/2 over cleartext TCP. h2c is not in the default list: no
# browser implements it, and it would be advertised on every plain HTTP vHost.
# mod_qos understands HTTP 1.0 and 1.1 (RFC1945/RFC2616) only, so on a host that enables it, stay
# with its request level control directives ("QS_Loc*") once HTTP/2 is in play.
Protocols {{ apache_httpd__mod_http2_protocols }}

# HTTP/2 hands every request to a worker thread of its own. That pool is separate from the MPM
# workers: it is not counted against ThreadsPerChild and does not show up in mod_status. Both
# bounds default to ThreadsPerChild when left unset.
{% if apache_httpd__mod_http2_min_workers | string | length > 0 %}
H2MinWorkers {{ apache_httpd__mod_http2_min_workers }}
{% endif %}
{% if apache_httpd__mod_http2_max_workers | string | length > 0 %}
H2MaxWorkers {{ apache_httpd__mod_http2_max_workers }}
{% endif %}

# The memory footprint of an HTTP/2 connection: how many requests a client may have in flight, how
# much request body the server has to buffer per request, and how much response data it buffers
# before it suspends the worker producing it.
H2MaxSessionStreams {{ apache_httpd__mod_http2_max_session_streams }}
H2WindowSize {{ apache_httpd__mod_http2_window_size }}
H2StreamMaxMemSize {{ apache_httpd__mod_http2_stream_max_mem_size }}

# Sends a "103 Early Hints" response carrying the Link headers of H2PushResource as soon as the
# request starts processing, rather than once the response headers are known. Off upstream because
# some older browsers trip on such responses. This is the replacement for HTTP/2 Server Push, which
# RFC 9113 deprecated and which Chrome and Edge removed in version 106.
H2EarlyHints {{ apache_httpd__mod_http2_early_hints }}


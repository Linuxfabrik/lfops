# threaded/hybrid server

# StartServers: initial number of server processes to start
# MinSpareThreads: minimum number of worker threads which are kept spare
# MaxSpareThreads: maximum number of worker threads which are kept spare
# ServerLimit: upper limit for the number of server processes, including those shutting down
# ThreadsPerChild: constant number of worker threads in each server process
# MaxRequestWorkers: maximum number of worker threads
# MaxConnectionsPerChild: maximum number of requests a server process serves

# mpm_event_module
StartServers            {{ apache_httpd__mpm_event_start_servers }}
MinSpareThreads         {{ apache_httpd__mpm_event_min_spare_threads }}
MaxSpareThreads         {{ apache_httpd__mpm_event_max_spare_threads }}
ThreadLimit             {{ apache_httpd__mpm_event_thread_limit }}
ThreadsPerChild         {{ apache_httpd__mpm_event_threads_per_child }}
MaxRequestWorkers       {{ apache_httpd__mpm_event_max_request_workers }}
MaxConnectionsPerChild  {{ apache_httpd__mpm_event_max_connections_per_child }}

# A server process that is told to stop keeps its scoreboard slot for as long as one of its
# connections lives (a WebSocket, a long download). While every slot is taken, Apache cannot start
# a process to replace it, even though MaxRequestWorkers is far from reached, and logs AH03490.
# The default therefore leaves as many spare slots as MaxRequestWorkers needs processes.
# A reload ignores a changed ServerLimit; the role restarts Apache for it.
ServerLimit             {{ apache_httpd__mpm_event_server_limit }}



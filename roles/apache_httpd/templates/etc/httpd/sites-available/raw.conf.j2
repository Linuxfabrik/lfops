# {{ ansible_managed }}
# 2026111801
# Raw (self-defined) vHost
{% if item['by_role'] | d() %}
# Generated by Ansible role: {{ item['by_role'] }}
{% endif %}

# {{ item['comment'] | d('no description available') }}
<VirtualHost {{ item['virtualhost_ip'] | d('*') }}:{{ item['virtualhost_port'] }}>
    ServerName {{ item['conf_server_name'] }}
{% if item['conf_server_alias'] is defined and item['conf_server_alias'] | length %}
{% for alias in item['conf_server_alias'] %}
    ServerAlias {{ alias }}
{% endfor %}
{% endif %}
{% set __raw = item['raw'] | d('') %}
{# a directive the raw content sets itself is left out: a second CustomLog would log every request twice #}
{% if __raw is not search('^\\s*ErrorLog\\s', multiline=true) %}
    ErrorLog "{{ item['conf_error_log'] | d('logs/' ~ item['conf_server_name'] ~ '-error.log') }}"
{% endif %}
{% if __raw is not search('^\\s*LogLevel\\s', multiline=true) %}
    LogLevel {{ item['conf_log_level'] | d('notice core:info') }}
{% endif %}
{% set __conf_custom_log = item['conf_custom_log'] | d('logs/' ~ item['conf_server_name'] ~ '-access.log combined') %}
{% if __raw is not search('^\\s*(CustomLog|TransferLog)\\s', multiline=true) and __conf_custom_log | length > 0 %}
    # log_config_module
    CustomLog {{ __conf_custom_log }}
{% endif %}

{% if item['raw'] | d() %}
# raw content
{{ item['raw'] }}
{% endif %}
</VirtualHost>

# Login of the dump user, read by /usr/local/bin/mariadb-dump with `--defaults-extra-file`, so
# that the password does not show up in the process list. Inside double quotes, the option file
# parser unescapes `\\` and `\"`.

[client]
user = "{{ mariadb_server__dump_user['username'] | replace('\\', '\\\\') | replace('"', '\\"') }}"
password = "{{ mariadb_server__dump_user['password'] | replace('\\', '\\\\') | replace('"', '\\"') }}"

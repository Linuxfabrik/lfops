[Unit]
Description=mariadbdump Service

[Service]
ExecStart=/usr/local/bin/mariadb-dump
Type=oneshot
User=root
# the dump must not slow down MariaDB and the applications behind it. Nice= and the CPU / IO
# weights (default 100) only matter under contention, so an idle host dumps at full speed.
# best-effort instead of idle: mydumper holds `LOCK TABLES ... READ LOCAL` on every non-InnoDB
# table (MyISAM, Aria, most of `mysql.*`) until that table is dumped, so a starved dump keeps
# writes to these tables waiting. verified against mydumper 1.0.11 and MariaDB 11.8 on Rocky 9.
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20

[Install]
WantedBy=basic.target

# Order MariaDB after TuneD, so that the kernel settings this host depends on
# (fs.aio-max-nr) are applied before MariaDB reads them. InnoDB allocates its
# asynchronous IO contexts via io_setup() at startup, which fails with EAGAIN
# once fs.aio-max-nr is exhausted, taking the whole server down with it.
# tuned.service is Type=dbus and TuneD claims com.redhat.tuned only after it has
# applied the profile, so After= is enough. An ordering dependency on a unit
# that is not installed is ignored, so this drop-in is harmless without TuneD.

[Unit]
After=tuned.service

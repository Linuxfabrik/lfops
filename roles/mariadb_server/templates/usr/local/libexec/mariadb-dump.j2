# no `set -e` because we change some things at the beginning of the script
# and have to reset them at the end
function exit_with_first_failed_retc() {
    for retc in "$@"; do
        if [ "$retc" -ne 0 ]; then
            exit "$retc"
        fi
    done
}


# true if version $1 is the same as or newer than version $2 (plain `X.Y.Z[-N]`, no leading "v")
function version_ge() {
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort --version-sort | tail -n 1)" == "$1" ]
}


# make sure the backup is not readable by others
old_umask=$(umask)
umask 027

source /etc/mariadb-dump.conf

# the login of the dump user, kept out of the command line (and the process list). With systemd
# 251 and newer, mariadb-dump.service decrypts it to $CREDENTIALS_DIRECTORY, older systemd keeps it
# in plain text in /etc/credstore.
login_file="${CREDENTIALS_DIRECTORY:-/etc/credstore}/mariadb-dump-login.cnf"
if [ ! -r "$login_file" ]; then
    echo "Cannot read $login_file. Run the dump with 'systemctl start mariadb-dump.service'." >&2
    exit 1
fi

# mysql: Deprecated program name. It will be removed in a future release, use '/usr/bin/mariadb' instead
# so `mariadb` or `mysql`?
MYSQL=$(which mariadb 2> /dev/null)
if [ -z "$MYSQL" ]; then
    MYSQL=$(which mysql 2> /dev/null)
fi
if [ -z "$MYSQL" ]; then
    exit 42
fi

rm -rf "$BACKUP_DIR"
mkdir -p "$BACKUP_DIR"

$MYSQL --defaults-extra-file="$login_file" --host="$HOST" \
    --execute='SET GLOBAL innodb_buffer_pool_dump_now = ON;'
mysql_table_lock_retc=$?


# https://github.com/mydumper/mydumper

# get installed mydumper version ("mydumper v0.15.1-3, built against MySQL 8.0.33-25 with SSL support"
# on RHEL, "mydumper 0.10.0, built against MySQL 8.0.36" in the Debian and Ubuntu repositories).
# strip the comma and the leading "v", so that version_ge() compares the same way for both.
mydumper_version=$(mydumper --version | awk '{print $2}' | tr --delete ',' | sed 's/^v//')

if version_ge "$mydumper_version" 0.14.5-1; then
    # parameter available since mydumper v0.14.5-1
    mydumper_login=(--defaults-extra-file="$login_file")
else
    # older versions (0.10.x in the Debian and Ubuntu repositories) only take the login on the
    # command line. my_print_defaults returns it as `--user=...` and `--password=...`.
    mapfile -t mydumper_login < <(my_print_defaults --defaults-file="$login_file" client)
fi

# build the cmdline parameters for mydumper
mydumper_params="--host=$HOST "
mydumper_params+="--build-empty-files "
if [ -n "$COMPRESS" ]; then
    mydumper_params+="--compress=$COMPRESS "
fi
if version_ge "$mydumper_version" 0.15.2-8; then
    # parameter available since mydumper v0.15.2-8
    mydumper_params+="--dirty "
fi
mydumper_params+="--events "
mydumper_params+="--logfile=$BACKUP_DIR/mydumper.log "
mydumper_params+="--long-query-guard=$LONG_QUERY_GUARD "
mydumper_params+="--outputdir=$BACKUP_DIR "
mydumper_params+="--routines "
if [ "$THREADS" -eq 0 ] && ! version_ge "$mydumper_version" 0.15.3-1; then
    # 0 means "number of CPUs" only since mydumper v0.15.3-1; older versions (0.10.x in the
    # Debian and Ubuntu repositories) wait forever without a single worker
    THREADS=$(nproc)
fi
mydumper_params+="--threads=$THREADS "
mydumper_params+="--triggers "
if version_ge "$mydumper_version" 0.20.1-1; then
    # `--trx-tables=0` takes an argument since mydumper v0.20.1-1, where it also turned on by
    # default. older versions do not know the argument and behave like "0" anyway.
    mydumper_params+="--trx-tables=0 "
fi
mydumper_params+="--verbose=3 "
mydumper_params+="$RAW "

# run mydumper
mydumper "${mydumper_login[@]}" $mydumper_params
mydumper_retc=$?

umask "$old_umask"

$MYSQL --defaults-extra-file="$login_file" --host="$HOST" \
    --execute='SET GLOBAL innodb_buffer_pool_load_now = ON;'
mysql_table_unlock_retc=$?

exit_with_first_failed_retc $mydumper_retc $mysql_table_lock_retc $mysql_table_unlock_retc

# {{ ansible_managed }}
# 2026110501

# sshd uses the first value it reads, and the Include at the top of sshd_config pulls in the
# drop-ins before the rest of that file. The 50-redhat.conf of the openssh-server package sets
# GSSAPIAuthentication yes and X11Forwarding yes, so the values have to come from a drop-in that
# sorts in front of it.
GSSAPIAuthentication {{ sshd__gssapi_authentication | bool | ternary("yes", "no") }}
X11Forwarding {{ sshd__x11_forwarding | bool | ternary("yes", "no") }}

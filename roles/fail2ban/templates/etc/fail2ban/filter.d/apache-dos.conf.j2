# {{ ansible_managed }}
# 2026112601

# Fail2Ban filter that matches all requests (for any ressource) on Apache servers.
#
# Should be used with a low bantime and findtime, and high maxretry.
# This effectively slows down the requests, for example a `ab -n 5000 http://ip-of-my-host/`.
#
# Tested with the following Apache LogFormats:
#
# LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
# LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\" %I %O" combinedio
# LogFormat "%h %l %u %t \"%r\" %>s %b" common
#
# LogFormat "%v %h %l %u %t \"%r\" %>s %b" vhost_common

[INCLUDES]

# overwrite with apache-common.local if _apache_error_client is incorrect.
before = apache-common.conf


[Definition]

# Line 1: %h %l %u %t (combined, combinedio, common)
# Line 2: %v %h %l %u %t (vhost_common), also with an IP address as ServerName
# A bare ^<HOST> would take the %v of vhost_common as the client, resolve it through
# DNS and count every request of the vHost as one client. Verified with fail2ban 1.0.2 on Rocky 8
# and 1.1.0 on Rocky 9 and 10.
failregex = ^<HOST> \S+ \S+ \[
            ^\S+ <HOST> \S+ \S+ \[

datepattern = ^[^\[]*\[({DATE})
              {^LN-BEG}


# DEV Notes:
#
# example log lines (combined, combinedio, common):
# 10.80.32.156 - - [27/Nov/2020:14:10:55 +0100] "GET / HTTP/1.0" 200 252910 "-" "Mozilla/5.0"
# 10.80.32.156 - - [27/Nov/2020:14:10:55 +0100] "GET / HTTP/1.0" 200 252910 "-" "Mozilla/5.0" 346 3157
# 10.80.32.156 - - [27/Nov/2020:14:10:55 +0100] "GET / HTTP/1.0" 200 252910
# example log lines (vhost_common):
# www.example.com 10.80.32.156 - - [27/Nov/2020:14:10:55 +0100] "GET / HTTP/1.0" 200 252910

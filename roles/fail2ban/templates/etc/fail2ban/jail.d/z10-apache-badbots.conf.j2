# The jail from jail.conf, with its port, maxretry, findtime and bantime. Only
# the log path is set: jail.conf reads /var/log/httpd/*access_log, while the
# virtual hosts of the apache_httpd role log to /var/log/httpd/<name>-access.log.
[apache-badbots]
enabled = true
logpath = /var/log/httpd/*access?log

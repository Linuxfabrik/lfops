# {{ ansible_managed }}
# 2026112301

# The jail from jail.conf, with its port, maxretry, findtime and bantime.
# Besides the action, only the log path is set: jail.conf reads
# /var/log/httpd/*access_log (and the nginx logs), while the virtual hosts of
# the apache_httpd role log to /var/log/httpd/<name>-access.log.
# action_kill (z00-defaults.conf) also closes the open connections of a banned
# client.
[php-url-fopen]
action  = %(action_kill)s
enabled = true
logpath = /var/log/httpd/*access?log

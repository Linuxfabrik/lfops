# {{ ansible_managed }}
# 2026112401

[apache-dos]
# The ban rule only applies to new connections, and ss-kill closes
# the established ones. Rejecting the packets of established connections
# instead keeps every httpd worker that is reading a request from the banned
# client, such as one in the middle of a TLS handshake, waiting for packets that
# never arrive until Timeout expires, so the ban itself exhausts
# MaxRequestWorkers. A reject with tcp-reset frees none of them, since the RST
# only goes to the client. Without ss-kill, a client keeps sending requests
# over an HTTP/2 connection it keeps busy, since mod_http2 ignores
# MaxKeepAliveRequests. Verified with fail2ban 1.1.1 and httpd 2.4.63 (event
# MPM) on Rocky 10.
{% if fail2ban__jail_default_banaction is match('nftables') %}
# nftables.conf has no pre-rule; nft takes further matches before the verdict,
# so the rule reads `tcp dport { http,https } ip saddr @addr-set-apache-dos ct
# state new reject`. Verified with fail2ban 1.1.1 on Rocky 8 and 10 (Molecule
# scenario fail2ban/install).
action   = %(banaction)s[name=%(__name__)s, bantime="%(bantime)s", port="%(port)s", protocol="%(protocol)s", chain="%(chain)s", blocktype="ct state new reject"]
{% else %}
action   = %(banaction)s[name=%(__name__)s, bantime="%(bantime)s", port="%(port)s", protocol="%(protocol)s", chain="%(chain)s", pre-rule="-m state --state NEW<sp>"]
{% endif %}
           ss-kill[port="%(port)s"]
bantime  = 5m
# Each further ban of the same address doubles the bantime, since a scanner
# usually comes back right after the ban expires. fail2ban forgets an address
# after dbpurgeage (1d).
bantime.increment = true
bantime.maxtime   = 1d
enabled  = true
findtime = 10s
logpath  = /var/log/httpd/*access?log
maxretry = 600
port     = http,https

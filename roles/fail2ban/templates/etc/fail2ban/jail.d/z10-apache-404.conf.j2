[apache-404]
action   = %(action_kill)s
bantime  = {{ fail2ban__jail_apache_404_bantime }}
enabled  = true
findtime = {{ fail2ban__jail_apache_404_findtime }}
logpath  = /var/log/httpd/*access?log
maxretry = {{ fail2ban__jail_apache_404_maxretry }}
port     = http,https

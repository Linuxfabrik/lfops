# The jail from jail.conf, with its port, maxretry, findtime and bantime. Only
# the log path is set: jail.conf reads /var/log/httpd/*error_log, while the
# virtual hosts of the apache_httpd role log to /var/log/httpd/<name>-error.log.
[apache-botsearch]
enabled = true
logpath = /var/log/httpd/*error?log

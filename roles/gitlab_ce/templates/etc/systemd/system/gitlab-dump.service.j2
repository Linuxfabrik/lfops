# {{ ansible_managed }}
# 2026111201

[Unit]
Description=Dumps (Backups) for GitLab

[Service]
# No `-` prefix: gitlab-backup exits with 1 if a part of the dump failed, and the unit has to
# fail then. The warning that gitlab.rb and gitlab-secrets.json are not part of the backup does
# not change the exit code (lib/backup/manager.rb and lib/tasks/gitlab/backup.rb, GitLab 19.5).
# STRATEGY=copy copies the files to the backup path before archiving them, so tar does not
# fail with "file changed as we read it" on a running instance.
ExecStart=/usr/bin/gitlab-backup create STRATEGY=copy
Type=oneshot
User=root
# the dump must not slow down GitLab and the applications behind it. Nice= and the CPU / IO
# weights (default 100) only matter under contention, so an idle host dumps at full speed.
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20

# {{ ansible_managed }}
# 2026101301

[Unit]
Description=Dumps (Backups) for GitLab

[Service]
# ignore "Warning: Your gitlab.rb and gitlab-secrets.json files contain sensitive data and are not included in this backup"
# by prefixing the path with a minus sign (we backup /etc using other tools, so its safe to ignore the warning)
ExecStart=-/usr/bin/gitlab-backup create
Type=oneshot
User=root
# the dump must not slow down GitLab and the applications behind it. Nice= and the CPU / IO
# weights (default 100) only matter under contention, so an idle host dumps at full speed.
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20

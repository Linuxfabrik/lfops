# {{ ansible_managed }}
# 2026090201

[Unit]
Description=Keycloak Service
After=network.target

[Service]
User=keycloak
Group=keycloak
EnvironmentFile={{ __keycloak__sysconfig_path }}
{% if keycloak__version is ansible.builtin.version('26.6.0', '<') %}
{# transaction-default-timeout only exists as of 26.6.0, older releases take the Quarkus property, in seconds #}
ExecStart={{ __keycloak__install_dir }}/bin/kc.sh {{ (keycloak__mode == 'production') | ternary('start', 'start-dev') }} -Dquarkus.transaction-manager.default-transaction-timeout={{ keycloak__transaction_default_timeout }}
{% else %}
ExecStart={{ __keycloak__install_dir }}/bin/kc.sh {{ (keycloak__mode == 'production') | ternary('start', 'start-dev') }}
{% endif %}
LimitNOFILE={{ keycloak__limit_nofile }}
WorkingDirectory={{ __keycloak__install_dir }}

[Install]
WantedBy=multi-user.target

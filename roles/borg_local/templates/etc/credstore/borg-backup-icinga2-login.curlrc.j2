# Login of the Icinga2 downtime API user, stored as the systemd credential
# `borg-backup-icinga2-login.curlrc` (encrypted in /etc/credstore.encrypted/ with systemd
# 251 and newer, else in /etc/credstore/). borg-backup passes it to `curl --config` through a
# pipe, so that the login does not show up in the process list.

header = "Authorization: Basic {{ (borg_local__icinga2_api_user_login['username'] ~ ':' ~ borg_local__icinga2_api_user_login['password']) | b64encode }}"

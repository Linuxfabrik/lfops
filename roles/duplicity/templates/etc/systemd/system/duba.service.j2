# {{ ansible_managed }}
# 2026102901

[Unit]
Description=duba (Duplicity Backup) service

[Service]
ExecStart=/usr/local/bin/duba
Type=oneshot
User=root
{% if __duplicity__login_credential_result['encrypted'] | d(false) %}
# decrypted to $CREDENTIALS_DIRECTORY on every start
LoadCredentialEncrypted=duba-login.json
{% endif %}

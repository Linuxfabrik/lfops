import argparse  # pylint: disable=C0413
import json  # pylint: disable=C0413
import logging  # pylint: disable=C0413
import os  # pylint: disable=C0413
import re  # pylint: disable=C0413
import subprocess  # pylint: disable=C0413
import sys  # pylint: disable=C0413
import tempfile  # pylint: disable=C0413
import time  # pylint: disable=C0413
from traceback import format_exc  # pylint: disable=C0413

__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026102905'

DESCRIPTION = 'Do a massive parallel backup to a Swift storage backend with duplicity.'

EPILOG = """commands:
  backup  Back up all sources, then remove the backups older than the retention time.
          This is the default.
  exec    Run duplicity with the arguments after `--`, in the environment of the backup
          (the settings from the config file and the login from the systemd credential
          duba-login.json). If the config file sets an archive dir, it is passed as the
          first argument, so duplicity uses the cache of the backup instead of building
          another one in ~/.cache/duplicity. A later --archive-dir overrides it.
  restore PATH
          Restore PATH, a file or directory as it was on this host, into the --target
          directory, never over the live data. duba finds the backup that holds PATH
          from the backup sources in the config file. For the options duba does not
          offer, use `duba exec -- restore`.

examples:
  duba
  duba exec -- collection-status swift://container/etc
  duba restore /etc/hosts
  duba restore --time=3D --dry-run /var/www/html/nextcloud/config/config.php
"""

COMMANDS = ['backup', 'exec', 'restore']

# The size of a backup volume in MB. It is also the default of duplicity, which a restore
# uses for its check of the temp dir, see warn_on_low_space().
VOLSIZE_MB = 200

# The secret environment variables (SWIFT_PASSWORD, FTP_PASSWORD) are not in the config file,
# but in this systemd credential, see load_credential().
CREDENTIAL_NAME = 'duba-login.json'


def parse_args(argv):
    """Parse command line arguments using argparse.
    """
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        '-V', '--version',
        action='version',
        version='{0}: v{1} by {2}'.format('%(prog)s', __version__, __author__)
    )

    parser.add_argument(
        '--config',
        help='Path to JSON config file. Default: %(default)s',
        dest='CONFIG_FILE',
        default='/etc/duba/duba.json',
    )

    # COMMAND and PATH share one positional, so that `--command=restore PATH` works as well
    parser.add_argument(
        'POSITIONALS',
        help='The command to run (see below; default: backup), and the PATH for restore.',
        metavar='COMMAND [PATH]',
        nargs='*',
    )

    parser.add_argument(
        '--command',
        help='Same as COMMAND.',
        dest='COMMAND_OPTION',
        choices=COMMANDS,
    )

    parser.add_argument(
        '--dry-run',
        help='restore: Only show which backup holds PATH and the duplicity command.',
        dest='DRY_RUN',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--target',
        help='restore: Directory to restore into, PATH is recreated below it.'
             ' Default: a new directory /var/tmp/duba-restore-<random>',
        dest='TARGET',
    )

    parser.add_argument(
        '--time',
        help='restore: Restore the state as of this time, in the time format of duplicity'
             ' (e.g. 3D, 2026-10-01, 2026-10-01T12:00:00). Default: the latest backup',
        dest='TIME',
    )

    # intermixed, so that PATH may follow the options
    args = parser.parse_intermixed_args(argv)
    positionals = list(args.POSITIONALS)
    args.COMMAND = positionals.pop(0) if positionals and positionals[0] in COMMANDS else None
    if args.COMMAND and args.COMMAND_OPTION and args.COMMAND != args.COMMAND_OPTION:
        parser.error(f'COMMAND {args.COMMAND} conflicts with --command={args.COMMAND_OPTION}')
    args.COMMAND = args.COMMAND or args.COMMAND_OPTION or 'backup'

    args.PATH = None
    if args.COMMAND == 'restore':
        if len(positionals) != 1:
            parser.error('restore needs exactly one PATH')
        args.PATH = positionals[0]
    elif positionals:
        parser.error(f'unknown command or extra argument: {" ".join(positionals)}')
    elif args.DRY_RUN or args.TARGET or args.TIME:
        parser.error('--dry-run, --target and --time are only allowed with restore')
    return args

class Duba:

    def __init__(self, config_file='/etc/duba/duba.json'):
        self.config = self.load_config(config_file)
        self.logger = self.init_logging()
        self.duplicity_version = self.get_duplicity_version()
        # self.use_concurrency = self.duplicity_version >= (3, 0, 0)


    def init_logging(self):
        logger = logging.getLogger()
        logger.setLevel(logging.DEBUG)

        console_logger = logging.StreamHandler()
        console_logger.setLevel(logging.DEBUG)
        console_logger.setFormatter(logging.Formatter(
            '%(asctime)s %(levelname)s: duba - %(message)s', datefmt='%Y-%m-%d %H:%M:%S'
        ))
        logger.addHandler(console_logger)

        # try creating logfile directory for duplicity
        try:
            os.mkdir(self.config.get('logdir', '/var/log/duplicity'), 0o640)
        except OSError:
            pass

        return logger


    def load_config(self, config_file):
        # load config file
        try:
            with open(config_file, 'r') as f:
                config = f.read()
        except IOError as e:
            self.logger.exception(f'I/O error: {e.strerror} while opening or reading {config_file}')
            sys.exit(201)
        except:
            self.logger.exception(f'Unknown error opening or reading {config_file}')
            sys.exit(202)

        # interpret config
        try:
            return json.loads(config)
        except json.JSONDecodeError as e:
            self.logger.exception(f'JSON decode error: {e}')
            sys.exit(203)


    def get_duplicity_version(self):
        try:
            # result = subprocess.run(['duplicity', '--version'], capture_output=True, text=True, check=True)
            p = subprocess.Popen(['duplicity', '--version'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False)
            stdout, _ = p.communicate()
            version_line = stdout.decode('utf-8').strip()
            version_match = re.search(r'(\d+\.\d+\.\d+)', version_line)
            if version_match:
                return tuple(map(int, version_match.group(1).split('.')))
            else:
                raise ValueError(f"Could not parse duplicity version from output: {version_line}")
        except Exception as e:
            self.logger.exception(f"Error fetching duplicity version: {e}")
            sys.exit(250)


    def load_credential(self):
        # duba.service decrypts the credential to $CREDENTIALS_DIRECTORY. systemd before 251
        # keeps it in plain text in /etc/credstore. Started by hand, duba decrypts it itself,
        # which needs root, since the host key is readable by root only. Without a credential,
        # the backend needs no secret (e.g. sftp with key authentication).
        for directory in (os.environ.get('CREDENTIALS_DIRECTORY'), '/etc/credstore'):
            if not directory:
                continue
            path = os.path.join(directory, CREDENTIAL_NAME)
            if not os.path.isfile(path):
                continue
            try:
                with open(path, 'r') as f:
                    return json.load(f)
            except (OSError, ValueError) as e:
                self.logger.error(f'Error reading {path}: {e}')
                sys.exit(208)

        path = os.path.join('/etc/credstore.encrypted', CREDENTIAL_NAME)
        if not os.path.isfile(path):
            return {}
        # the secret goes to stdout, never to the command line
        p = subprocess.run(
            ['systemd-creds', 'decrypt', f'--name={CREDENTIAL_NAME}', path, '-'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if p.returncode != 0:
            self.logger.error(
                f'Error decrypting {path} (run duba as root, or the role again after a firmware'
                f' or Secure Boot change): {p.stderr.decode("utf-8", "replace").strip()}'
            )
            sys.exit(209)
        try:
            return json.loads(p.stdout)
        except ValueError as e:
            self.logger.error(f'Error reading {path}: {e}')
            sys.exit(208)


    def set_env(self, env_config, env=os.environ.copy()):
        # enrich the environment variables
        env['LC_ALL'] = 'C' # set cmd output to English, no matter what the user has choosen
        env.update(env_config)
        env.update(self.load_credential())
        return env


    def archive_dir_options(self):
        # duplicity appends a hash of the backup URL to the archive dir, so all calls can share it.
        # Backup and cleanup have to use the same dir, otherwise the cleanup works on another cache.
        archive_dir = self.config.get('archive_dir', '')
        if not archive_dir:
            return []
        return ['--archive-dir', f"{archive_dir}"]


    def build_duplicity_backup_command(self, backup_path, backup_options):
        # build the duplicity backup command line
        cmd = ['ionice', '--class', '3']
        cmd += ['nice', '--adjustment', '19']
        cmd += ['duplicity']
        if self.duplicity_version >= (2, 0, 0):
            cmd += ['backup']

        if self.duplicity_version >= (3, 0, 0):
            cmd += ['--concurrency', '2']
        else:
            cmd += ['--asynchronous-upload']
        cmd += self.archive_dir_options()
        cmd += ['--backend-retry-delay', '60']
        cmd += ['--cf-backend', f"{self.config.get('backend', 'swift')}"]
        cmd += ['--encrypt-key', f"{self.config.get('gpg_encrypt_local_key', '')}"]
        cmd += ['--encrypt-key', f"{self.config.get('gpg_encrypt_master_key', '')}"]

        # global excludes
        for exclude in self.config.get('backup_excludes', []):
            cmd += ['--exclude', f"{exclude}"]

        # excludes for this directory
        for exclude in backup_options.get('excludes', []):
            cmd += ['--exclude', f"{exclude}"]

        cmd += ['--exclude-other-filesystems']
        cmd += ['--full-if-older-than', f"{self.config.get('full_if_older_than', '30D')}"]

        logfile = re.sub(r'[^A-Za-z0-9]+', '-', backup_path).lstrip('-')
        cmd += ['--log-file', f"{self.config.get('logdir', '/var/log/duplicity')}/{logfile}.log"]

        cmd += ['--log-timestamp']
        cmd += ['--num-retries', '5']
        cmd += ['--verbosity', f"{self.config.get('loglevel', 'notice')}"]
        cmd += ['--volsize', f'{VOLSIZE_MB}']

        cmd += [f"{backup_path}"]
        cmd += [f"{self.config.get('backup_dest')}{backup_path}"]

        return cmd


    def build_duplicity_cleanup_command(self, backup_path):
        # build the duplicity command line
        cmd = ['nice', '--adjustment', '19']
        cmd += ['duplicity']

        cmd += ['remove-older-than', f"{self.config.get('retention_time', '30D')}"]

        cmd += self.archive_dir_options()
        cmd += ['--backend-retry-delay', '60']
        cmd += ['--force']

        logfile = re.sub(r'[^A-Za-z0-9]+', '-', backup_path).lstrip('-')
        cmd += ['--log-file', f"{self.config.get('logdir', '/var/log/duplicity')}/{logfile}.log"]
        cmd += ['--log-timestamp']

        cmd += ['--num-retries', '5']
        cmd += ['--verbosity', f"{self.config.get('loglevel', 'notice')}"]

        cmd += [f"{self.config.get('backup_dest')}{backup_path}"]

        return cmd


    def run_cmd_in_background(self, cmd, env, running_procs, max_procs, failed_retcs):
        # start duplicity in the background
        # * start n processes: start up to (cpu-cores + 1) nice processes to backup as
        #   much as possible
        # * be as nice as possible: only when the machine is busy, the script is slower
        # * be asynchronous: uploading volumes while packaging new ones saves a lot of time
        # * use compression: saves money on external storages; bottleneck is always your uplink
        # and return immediately
        try:
            running_procs.append(subprocess.Popen(cmd, env=env))
        except OSError as e:
            self.logger.exception(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd}"')
            sys.exit(205)
        except ValueError as e:
            self.logger.exception(f'Value Error "{e}" calling command "{cmd}"')
            sys.exit(206)
        except Exception as e:
            self.logger.exception(f'Unknown error "{e}" while calling command "{cmd}"')
            sys.exit(207)

        # don't start more than max cpu processes
        while True:
            time.sleep(0.5)
            self.reap_finished_procs(running_procs, failed_retcs)
            if len(running_procs) <= max_procs:
                # allow launching of another process
                break


    def wait_for_running_procs(self, running_procs, failed_retcs):
        while running_procs:
            time.sleep(0.5)
            self.reap_finished_procs(running_procs, failed_retcs)


    def reap_finished_procs(self, running_procs, failed_retcs):
        # Collect the exit code of every finished process, not just of the last one
        # polled, so that one failed source fails the whole run. Iterates over a copy,
        # since finished processes are removed from the list.
        for proc in list(running_procs):
            retc = proc.poll()
            if retc is None:
                continue
            running_procs.remove(proc)
            self.logger.debug('Process terminated')
            # just ignore missing directories (backup_dir_doesnt_exist = 13)
            if retc not in (0, 13):
                self.logger.error(f"Exit code {retc}: {' '.join(proc.args)}")
                failed_retcs.append(retc)


    def divide_source_dir(self, src_path):
        filelist = []
        try:
            with os.scandir(src_path) as entries:
                for entry in entries:
                    filelist.append(entry.path)
        except Exception as e:
            self.logger.exception(f"Error reading source directory {src_path}: {e}")
        return filelist


    def do_backup(self):
        """Do a massive parallel backup using duplicity and swift as backend. After that, delete
           all backups older than the given retention time.
           This function works and is fast, but the code is not very good and could be improved later.
        """
        self.logger.info('Starting backup...')

        # count the number of logical processors to limit number of processes (code taken from psutil)
        cpu_count = min(os.sysconf('SC_NPROCESSORS_ONLN'), 6)
        env = self.set_env(self.config.get('env', {}))
        backup_failed_retcs = []
        cleanup_failed_retcs = []

        # iterate over backup dirs and spawn processes
        running_procs = []
        for src in self.config.get('backup_sources', []):
            if not os.path.exists(src.get('path')):
                # be tolerant. skip non-existing paths to prevent duplicity error 23
                continue

            if src.get('divide', False):
                # divide the source dir:
                # do not backup the whole dir, but every item on the first level individually
                self.logger.debug(f"Dividing the source dir {src.get('path')}")
                src['filelist'] = self.divide_source_dir(src.get('path'))
            else:
                src['filelist'] = [src.get('path')]

            for f in src['filelist']:
                cmd = self.build_duplicity_backup_command(f, src)
                self.logger.info(f"Running: {' '.join(cmd)}")

                self.run_cmd_in_background(
                    cmd, env, running_procs, cpu_count, backup_failed_retcs
                )

        # wait here for all processes to finish
        self.logger.debug('All duplicity processes started, waiting for them to finish.')
        self.wait_for_running_procs(running_procs, backup_failed_retcs)

        self.logger.info('Backup done.')
        self.logger.info('Starting cleanup...')
        # Delete all backup sets older than the given time. Old backup sets will not be deleted if
        # backup sets newer than time depend on them. Note, this action cannot be combined with backup
        # or other actions, such as cleanup. Note also that --force will be needed to delete the files
        # instead of just listing them.

        # iterate over backup dirs and spawn processes
        running_procs = []
        for src in self.config.get('backup_sources', []):
            if not os.path.exists(src.get('path')):
                # be tolerant. skip non-existing paths to prevent duplicity error 23
                continue

            for f in src['filelist']:
                cmd = self.build_duplicity_cleanup_command(f)
                self.logger.info(f"Running: {' '.join(cmd)}")

                self.run_cmd_in_background(
                    cmd, env, running_procs, cpu_count, cleanup_failed_retcs
                )


        # wait here for all processes to finish
        self.logger.debug('All duplicity processes started, waiting for them to finish.')
        self.wait_for_running_procs(running_procs, cleanup_failed_retcs)

        self.logger.info('Cleanup done.')
        # a failed backup takes precedence over a failed cleanup
        sys.exit((backup_failed_retcs + cleanup_failed_retcs + [0])[0])


    def do_exec(self, duplicity_args):
        """Replace duba with duplicity, called with `duplicity_args` in the environment of the
           backup, so that the secrets never show up in the shell of the admin.
        """
        if not duplicity_args:
            self.logger.error('Nothing to run. Usage: duba exec -- <duplicity arguments>')
            sys.exit(210)
        # duplicity accepts options in front of the action
        cmd = ['duplicity'] + self.archive_dir_options() + duplicity_args
        env = self.set_env(self.config.get('env', {}))
        try:
            os.execvpe(cmd[0], cmd, env)
        except OSError as e:
            self.logger.error(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd[0]}"')
            sys.exit(205)


    def find_backup(self, path):
        """Return the source, the backup path (the local path duba passed to duplicity, which
           is also appended to the backup URL) and the path to restore inside that backup.
        """
        # the most specific source wins, e.g. /var/www/html/nextcloud/data over /var/www/html
        source = None
        for src in self.config.get('backup_sources', []):
            src_path = os.path.normpath(src.get('path'))
            if path != src_path and not path.startswith(src_path.rstrip('/') + '/'):
                continue
            if source is None or len(src_path) > len(os.path.normpath(source.get('path'))):
                source = src
        if source is None:
            self.logger.error(
                f'{path} is in none of the backup sources: '
                f"{', '.join(src.get('path') for src in self.config.get('backup_sources', []))}"
            )
            sys.exit(211)

        src_path = os.path.normpath(source.get('path'))
        rel_path = os.path.relpath(path, src_path) if path != src_path else ''
        if not source.get('divide', False):
            # build_duplicity_backup_command() appends the configured path as it is
            return source, source.get('path'), rel_path
        # a divided source has one backup per entry on its first level, see do_backup()
        if not rel_path:
            self.logger.error(
                f'{path} is divided into one backup per entry, restore the entries one by one'
            )
            sys.exit(212)
        entry, _, rest = rel_path.partition('/')
        return source, os.path.join(source.get('path'), entry), rest


    def warn_on_low_space(self, path, target):
        # Only warnings: the restore goes into its own directory, so running out of space
        # does not harm the live data. The local copy, if there still is one, is the only size
        # estimate there is, since the duplicity metadata does not hold the file sizes.
        if os.path.lexists(path):
            size = 0
            if os.path.isdir(path) and not os.path.islink(path):
                for root, _, files in os.walk(path):
                    for name in files:
                        try:
                            size += os.lstat(os.path.join(root, name)).st_size
                        except OSError:
                            pass
            else:
                size = os.lstat(path).st_size
            stat = os.statvfs(target)
            free = stat.f_bavail * stat.f_frsize
            if free < size:
                self.logger.warning(
                    f'{target} has {free // 2**20} MB free, the local copy of {path} has'
                    f' {size // 2**20} MB'
                )
        # duplicity uses the same temp dir (TMPDIR, else /tmp). On start, it aborts with exit
        # code 35 if the temp dir has less than (concurrency + 2) volumes plus 30% of one
        # free, (concurrency + 1) before duplicity 3.0.1. A restore runs without concurrency.
        # Verified against the duplicity source, rel.0.8.23 to rel.3.2.1 (check_resources()).
        volumes = 2 if self.duplicity_version >= (3, 0, 1) else 1
        need_mb = int((volumes + 0.3) * VOLSIZE_MB)
        tempdir = tempfile.gettempdir()
        stat = os.statvfs(tempdir)
        free = stat.f_bavail * stat.f_frsize
        if free < need_mb * 2**20:
            self.logger.warning(
                f'{tempdir} has {free // 2**20} MB free, duplicity needs {need_mb} MB there'
                f' and will abort with exit code 35 (set TMPDIR to use another dir)'
            )


    def do_restore(self, path, target=None, restore_time=None, dry_run=False):
        """Restore `path` from the backup that holds it into `target`, below which `path` is
           recreated. duplicity refuses to restore into a directory that is not empty.
        """
        path = os.path.abspath(path)
        source, backup_path, path_to_restore = self.find_backup(path)
        # The restored files keep their owner and mode, but not the protection of the
        # parent directories they had on the host (e.g. /root), so the directories duba
        # creates are for root only. The default target gets a random name, any local
        # user could create a predictable one below /var/tmp in advance.
        os.umask(0o077)
        if not target:
            if dry_run:
                target = '/var/tmp/duba-restore-<random>'
            else:
                target = tempfile.mkdtemp(prefix='duba-restore-', dir='/var/tmp')
        restore_path = os.path.join(os.path.abspath(target), path.lstrip('/'))

        cmd = ['duplicity', 'restore']
        cmd += self.archive_dir_options()
        cmd += ['--backend-retry-delay', '60']
        cmd += ['--num-retries', '5']
        if path_to_restore:
            # renamed in duplicity 2.0.0
            if self.duplicity_version >= (2, 0, 0):
                cmd += ['--path-to-restore', path_to_restore]
            else:
                cmd += ['--file-to-restore', path_to_restore]
        if restore_time:
            cmd += ['--restore-time', restore_time]
        cmd += ['--verbosity', f"{self.config.get('loglevel', 'notice')}"]
        cmd += [f"{self.config.get('backup_dest')}{backup_path}"]
        cmd += [restore_path]

        if dry_run:
            print(f"Source:          {source.get('path')}")
            print(f"Backup URL:      {self.config.get('backup_dest')}{backup_path}")
            print(f'Path to restore: {path_to_restore or "(the whole backup)"}')
            print(f'Restore to:      {restore_path}')
            print(f"Command:         {' '.join(cmd)}")
            sys.exit(0)

        os.makedirs(os.path.dirname(restore_path), exist_ok=True)
        self.warn_on_low_space(path, os.path.dirname(restore_path))
        self.logger.info(f"Running: {' '.join(cmd)}")
        env = self.set_env(self.config.get('env', {}))
        try:
            retc = subprocess.run(cmd, env=env).returncode
        except OSError as e:
            self.logger.error(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd[0]}"')
            sys.exit(205)
        if retc == 0:
            self.logger.info(f'Restored {path} to {restore_path}')
        sys.exit(retc)


def main():
    """The main function. Hier spielt die Musik.
    """

    # everything after the first `--` belongs to duplicity
    argv = sys.argv[1:]
    duplicity_args = []
    if '--' in argv:
        duplicity_args = argv[argv.index('--') + 1:]
        argv = argv[:argv.index('--')]

    # parse the command line, exit if it fails
    try:
        args = parse_args(argv)
    except SystemExit:
        sys.exit(221)

    if duplicity_args and args.COMMAND != 'exec':
        print('duba: arguments after `--` are only allowed with `exec`', file=sys.stderr)
        sys.exit(221)

    duba = Duba(args.CONFIG_FILE)
    if args.COMMAND == 'backup':
        duba.do_backup()
    elif args.COMMAND == 'exec':
        duba.do_exec(duplicity_args)
    elif args.COMMAND == 'restore':
        duba.do_restore(args.PATH, args.TARGET, args.TIME, args.DRY_RUN)


if __name__ == '__main__':
    try:
        main()
    except Exception:   # pylint: disable=W0703
        print(format_exc().replace("<", "'").replace(">", "'"))
        sys.exit(222)

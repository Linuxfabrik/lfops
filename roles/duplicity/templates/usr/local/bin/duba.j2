DESCRIPTION = 'Do a massive parallel backup to a Swift storage backend with duplicity.'

EPILOG = """commands:
  backup  Back up all sources, then remove the backups older than the retention time.
          This is the default.
  exec    Run duplicity with the arguments after `--`, in the environment of the backup
          (the settings from the config file and the login from the systemd credential
          duba-login.json). If the config file sets an archive dir, it is passed as the
          first argument, so duplicity uses the cache of the backup instead of building
          another one in ~/.cache/duplicity. A later --archive-dir overrides it.
  restore PATH
          Restore PATH, a file or directory as it was on this host, into the --target
          directory, never over the live data. duba finds the backup that holds PATH
          from the backup sources in the config file. Before the restore, duba asks
          duplicity which volumes it needs, shows the backup the state comes from and
          aborts if the temp dir is too small for them. For the options duba does not
          offer, use `duba exec -- restore`.

examples:
  duba
  duba exec -- collection-status swift://container/etc
  duba restore /etc/hosts
  duba restore --time=3D --dry-run /var/www/html/nextcloud/config/config.php
"""

COMMANDS = ['backup', 'exec', 'restore']

# The size of a backup volume in MB. It is also the default of duplicity, which a restore
# uses for its check of the temp dir, see check_temp_space().
VOLSIZE_MB = 200

# A volume file is slightly larger than VOLSIZE_MB: 10.38 MB for --volsize 10, measured with
# duplicity 3.2.2 on Rocky 9.
VOLUME_OVERHEAD = 1.05

# A volume in the list of `duplicity restore --dry-run`, e.g.
# duplicity-inc.20260929T222204Z.to.20260930T222203Z.vol64.difftar.gpg. The last timestamp
# is the time of the backup set, in UTC.
VOLUME_REGEX = re.compile(
    r'duplicity-(?:full|inc)\.(?:\d{8}T\d{6}Z\.to\.)?(?P<time>\d{8}T\d{6}Z)\.vol\d+\.difftar'
)

# The number of volumes a duplicity 3.x backup builds and uploads at the same time.
BACKUP_CONCURRENCY = 2

# The secret environment variables (SWIFT_PASSWORD, FTP_PASSWORD) are not in the config file,
# but in this systemd credential, see load_credential().
CREDENTIAL_NAME = 'duba-login.json'


def exclude_fits_root(pattern, root):
    """Tell whether the exclude `pattern` may match something below the backup `root`.

    duplicity aborts the whole backup with exit code 14 ("The file specification ... cannot
    match any files in the base directory") if an exclude cannot match the backup root or
    one of its parents. With `divide: true`, every first-level entry is a backup of its
    own, so an exclude for one entry would break the backups of all the others. Compares
    the leading path components, `*`, `?` and `[...]` match within one component, `**`
    matches anything. Patterns that are not absolute (`**/cache`, `ignorecase:...`) are
    left to duplicity. Verified with duplicity 3.0.7 on Fedora 43 (glob_get_sf() and
    literal_get_sf() in duplicity/selection.py).
    """
    if not pattern.startswith('/'):
        return True
    pattern_parts = pattern.strip('/').split('/')
    root_parts = root.strip('/').split('/')
    for pattern_part, root_part in zip(pattern_parts, root_parts):
        if '**' in pattern_part:
            return True
        if not fnmatch.fnmatchcase(root_part, pattern_part):
            return False
    return True


def parse_args(argv):
    """Parse command line arguments using argparse.
    """
    parser = argparse.ArgumentParser(
        description=DESCRIPTION,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        '-V', '--version',
        action='version',
        version='{0}: v{1} by {2}'.format('%(prog)s', __version__, __author__)
    )

    parser.add_argument(
        '--config',
        help='Path to JSON config file. Default: %(default)s',
        dest='CONFIG_FILE',
        default='/etc/duba/duba.json',
    )

    # COMMAND and PATH share one positional, so that `--command=restore PATH` works as well
    parser.add_argument(
        'POSITIONALS',
        help='The command to run (see below; default: backup), and the PATH for restore.',
        metavar='COMMAND [PATH]',
        nargs='*',
    )

    parser.add_argument(
        '--command',
        help='Same as COMMAND.',
        dest='COMMAND_OPTION',
        choices=COMMANDS,
    )

    parser.add_argument(
        '--dry-run',
        help='restore: Only show which backup holds PATH, the backup the state comes from,'
             ' the temp space the restore needs and the duplicity command.',
        dest='DRY_RUN',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--ignore-space',
        help='restore: Restore even if the temp dir has less free space than the estimate.',
        dest='IGNORE_SPACE',
        action='store_true',
        default=False,
    )

    parser.add_argument(
        '--target',
        help='restore: Directory to restore into, PATH is recreated below it.'
             ' Default: a new directory /var/tmp/duba-restore-<random>',
        dest='TARGET',
    )

    parser.add_argument(
        '--time',
        help='restore: Restore the state as of this time, in the time format of duplicity'
             ' (e.g. 3D, 2026-10-01, 2026-10-01T12:00:00; a time needs the seconds, a date'
             ' means 00:00 local time). Default: the latest backup',
        dest='TIME',
    )

    # intermixed, so that PATH may follow the options
    args = parser.parse_intermixed_args(argv)
    positionals = list(args.POSITIONALS)
    args.COMMAND = positionals.pop(0) if positionals and positionals[0] in COMMANDS else None
    if args.COMMAND and args.COMMAND_OPTION and args.COMMAND != args.COMMAND_OPTION:
        parser.error(f'COMMAND {args.COMMAND} conflicts with --command={args.COMMAND_OPTION}')
    args.COMMAND = args.COMMAND or args.COMMAND_OPTION or 'backup'

    args.PATH = None
    if args.COMMAND == 'restore':
        if len(positionals) != 1:
            parser.error('restore needs exactly one PATH')
        args.PATH = positionals[0]
    elif positionals:
        parser.error(f'unknown command or extra argument: {" ".join(positionals)}')
    elif args.DRY_RUN or args.IGNORE_SPACE or args.TARGET or args.TIME:
        parser.error('--dry-run, --ignore-space, --target and --time are only allowed with restore')
    return args

class Duba:

    def __init__(self, config_file='/etc/duba/duba.json'):
        # the logger comes first, since load_config() reports its errors with it
        self.logger = self.init_logging()
        self.config = self.load_config(config_file)
        self.create_logdir()
        self.duplicity_version = self.get_duplicity_version()
        # self.use_concurrency = self.duplicity_version >= (3, 0, 0)


    def init_logging(self):
        logger = logging.getLogger()
        logger.setLevel(logging.DEBUG)

        console_logger = logging.StreamHandler()
        console_logger.setLevel(logging.DEBUG)
        console_logger.setFormatter(logging.Formatter(
            '%(asctime)s %(levelname)s: duba - %(message)s', datefmt='%Y-%m-%d %H:%M:%S'
        ))
        logger.addHandler(console_logger)

        return logger


    def create_logdir(self):
        # try creating logfile directory for duplicity
        try:
            os.mkdir(self.config.get('logdir', '/var/log/duplicity'), 0o640)
        except OSError:
            pass


    def load_config(self, config_file):
        # load config file
        try:
            with open(config_file, 'r') as f:
                config = f.read()
        except IOError as e:
            self.logger.error(f'I/O error: {e.strerror} while opening or reading {config_file}')
            sys.exit(201)
        except:
            self.logger.exception(f'Unknown error opening or reading {config_file}')
            sys.exit(202)

        # interpret config
        try:
            return json.loads(config)
        except json.JSONDecodeError as e:
            self.logger.error(f'JSON decode error in {config_file}: {e}')
            sys.exit(203)


    def get_duplicity_version(self):
        try:
            # result = subprocess.run(['duplicity', '--version'], capture_output=True, text=True, check=True)
            p = subprocess.Popen(['duplicity', '--version'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False)
            stdout, _ = p.communicate()
            version_line = stdout.decode('utf-8').strip()
            version_match = re.search(r'(\d+\.\d+\.\d+)', version_line)
            if version_match:
                return tuple(map(int, version_match.group(1).split('.')))
            else:
                raise ValueError(f"Could not parse duplicity version from output: {version_line}")
        except Exception as e:
            self.logger.exception(f"Error fetching duplicity version: {e}")
            sys.exit(250)


    def load_credential(self):
        # duba.service decrypts the credential to $CREDENTIALS_DIRECTORY. systemd before 251
        # keeps it in plain text in /etc/credstore. Started by hand, duba decrypts it itself,
        # which needs root, since the host key is readable by root only. Without a credential,
        # the backend needs no secret (e.g. sftp with key authentication).
        for directory in (os.environ.get('CREDENTIALS_DIRECTORY'), '/etc/credstore'):
            if not directory:
                continue
            path = os.path.join(directory, CREDENTIAL_NAME)
            if not os.path.isfile(path):
                continue
            try:
                with open(path, 'r') as f:
                    return json.load(f)
            except (OSError, ValueError) as e:
                self.logger.error(f'Error reading {path}: {e}')
                sys.exit(208)

        path = os.path.join('/etc/credstore.encrypted', CREDENTIAL_NAME)
        if not os.path.isfile(path):
            return {}
        # the secret goes to stdout, never to the command line
        p = subprocess.run(
            ['systemd-creds', 'decrypt', f'--name={CREDENTIAL_NAME}', path, '-'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if p.returncode != 0:
            self.logger.error(
                f'Error decrypting {path} (run duba as root, or the role again after a firmware'
                f' or Secure Boot change): {p.stderr.decode("utf-8", "replace").strip()}'
            )
            sys.exit(209)
        try:
            return json.loads(p.stdout)
        except ValueError as e:
            self.logger.error(f'Error reading {path}: {e}')
            sys.exit(208)


    def set_env(self, env_config, env=os.environ.copy()):
        # enrich the environment variables
        env['LC_ALL'] = 'C' # set cmd output to English, no matter what the user has choosen
        env.update(env_config)
        env.update(self.load_credential())
        return env


    def archive_dir_options(self):
        # duplicity appends a hash of the backup URL to the archive dir, so all calls can share it.
        # Backup and cleanup have to use the same dir, otherwise the cleanup works on another cache.
        archive_dir = self.config.get('archive_dir', '')
        if not archive_dir:
            return []
        return ['--archive-dir', f"{archive_dir}"]


    def build_duplicity_backup_command(self, backup_path, backup_options):
        # build the duplicity backup command line
        cmd = ['ionice', '--class', '3']
        cmd += ['nice', '--adjustment', '19']
        cmd += ['duplicity']
        if self.duplicity_version >= (2, 0, 0):
            cmd += ['backup']

        if self.duplicity_version >= (3, 0, 0):
            cmd += ['--concurrency', f'{BACKUP_CONCURRENCY}']
        else:
            cmd += ['--asynchronous-upload']
        cmd += self.archive_dir_options()
        cmd += ['--backend-retry-delay', '60']
        cmd += ['--cf-backend', f"{self.config.get('backend', 'swift')}"]
        cmd += ['--encrypt-key', f"{self.config.get('gpg_encrypt_local_key', '')}"]
        cmd += ['--encrypt-key', f"{self.config.get('gpg_encrypt_master_key', '')}"]

        # global excludes, then the excludes for this directory
        excludes = self.config.get('backup_excludes', []) + backup_options.get('excludes', [])
        for exclude in excludes:
            if not exclude_fits_root(exclude, backup_path):
                # e.g. /data/archive in the backup of /data/alice, a divided /data
                self.logger.debug(f'Skipping exclude {exclude}, it is outside {backup_path}')
                continue
            cmd += ['--exclude', f"{exclude}"]

        cmd += ['--exclude-other-filesystems']
        cmd += ['--full-if-older-than', f"{self.config.get('full_if_older_than', '30D')}"]

        logfile = re.sub(r'[^A-Za-z0-9]+', '-', backup_path).lstrip('-')
        cmd += ['--log-file', f"{self.config.get('logdir', '/var/log/duplicity')}/{logfile}.log"]

        cmd += ['--log-timestamp']
        cmd += ['--num-retries', '5']
        cmd += ['--verbosity', f"{self.config.get('loglevel', 'notice')}"]
        cmd += ['--volsize', f'{VOLSIZE_MB}']

        cmd += [f"{backup_path}"]
        cmd += [f"{self.config.get('backup_dest')}{backup_path}"]

        return cmd


    def build_duplicity_cleanup_command(self, backup_path):
        # build the duplicity command line
        cmd = ['nice', '--adjustment', '19']
        cmd += ['duplicity']

        cmd += ['remove-older-than', f"{self.config.get('retention_time', '30D')}"]

        cmd += self.archive_dir_options()
        cmd += ['--backend-retry-delay', '60']
        cmd += ['--force']

        logfile = re.sub(r'[^A-Za-z0-9]+', '-', backup_path).lstrip('-')
        cmd += ['--log-file', f"{self.config.get('logdir', '/var/log/duplicity')}/{logfile}.log"]
        cmd += ['--log-timestamp']

        cmd += ['--num-retries', '5']
        cmd += ['--verbosity', f"{self.config.get('loglevel', 'notice')}"]

        cmd += [f"{self.config.get('backup_dest')}{backup_path}"]

        return cmd


    def run_cmd_in_background(self, cmd, env, running_procs, max_procs, failed_retcs,
                              path=None, failed_paths=None):
        # start duplicity in the background
        # * start n processes: start up to max_procs nice processes (cpu-cores + 1, fewer for
        #   a backup if the temp dir lacks space) to backup as much as possible
        # * be as nice as possible: only when the machine is busy, the script is slower
        # * be asynchronous: uploading volumes while packaging new ones saves a lot of time
        # * use compression: saves money on external storages; bottleneck is always your uplink
        # and return immediately
        try:
            proc = subprocess.Popen(cmd, env=env)
        except OSError as e:
            self.logger.exception(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd}"')
            sys.exit(205)
        except ValueError as e:
            self.logger.exception(f'Value Error "{e}" calling command "{cmd}"')
            sys.exit(206)
        except Exception as e:
            self.logger.exception(f'Unknown error "{e}" while calling command "{cmd}"')
            sys.exit(207)
        # the path this process works on, for reap_finished_procs()
        proc.duba_path = path
        running_procs.append(proc)

        # don't start more than max_procs processes
        while True:
            time.sleep(0.5)
            self.reap_finished_procs(running_procs, failed_retcs, failed_paths)
            if len(running_procs) < max_procs:
                # allow launching of another process
                break


    def wait_for_running_procs(self, running_procs, failed_retcs, failed_paths=None):
        while running_procs:
            time.sleep(0.5)
            self.reap_finished_procs(running_procs, failed_retcs, failed_paths)


    def reap_finished_procs(self, running_procs, failed_retcs, failed_paths=None):
        # Collect the exit code of every finished process, not just of the last one
        # polled, so that one failed source fails the whole run. Iterates over a copy,
        # since finished processes are removed from the list. The path of a failed
        # process is added to `failed_paths`, if given.
        for proc in list(running_procs):
            retc = proc.poll()
            if retc is None:
                continue
            running_procs.remove(proc)
            self.logger.debug('Process terminated')
            # just ignore missing directories (backup_dir_doesnt_exist = 13)
            if retc not in (0, 13):
                self.logger.error(f"Exit code {retc}: {' '.join(proc.args)}")
                failed_retcs.append(retc)
                if failed_paths is not None:
                    failed_paths.add(proc.duba_path)


    def divide_source_dir(self, src_path):
        filelist = []
        try:
            with os.scandir(src_path) as entries:
                for entry in entries:
                    filelist.append(entry.path)
        except Exception as e:
            self.logger.exception(f"Error reading source directory {src_path}: {e}")
        return filelist


    def temp_dir(self, env):
        # duplicity builds its volumes in the temp dir of its own environment, which
        # Python's tempfile takes from TMPDIR, TEMP or TMP, else /tmp
        for name in ('TMPDIR', 'TEMP', 'TMP'):
            if env.get(name):
                return env[name]
        return '/tmp'


    def free_mb(self, path):
        stat = os.statvfs(path)
        return stat.f_bavail * stat.f_frsize // 2**20


    def backup_procs_fitting_temp_dir(self, env, max_procs):
        """Return how many backups may run at the same time, at most `max_procs`.

        On start, every duplicity backup checks the free space in its temp dir and aborts
        with exit code 35 if it has less than (concurrency + 2) volumes plus 30% of one,
        (concurrency + 1) before duplicity 3.0.1. --asynchronous-upload counts as a
        concurrency of 1. The backups running at the same time share the temp dir, so a
        backup that starts later finds less space than the first one. Verified against the
        duplicity source, rel.0.8.23 to rel.3.2.3.dev2 (check_resources()).
        """
        if self.duplicity_version >= (3, 0, 1):
            volumes = BACKUP_CONCURRENCY + 2
        elif self.duplicity_version >= (3, 0, 0):
            volumes = BACKUP_CONCURRENCY + 1
        else:
            volumes = 1 + 1
        need_mb = int((volumes + 0.3) * VOLSIZE_MB)
        tempdir = self.temp_dir(env)
        try:
            free_mb = self.free_mb(tempdir)
        except OSError as e:
            # duplicity reports this itself
            self.logger.warning(f'Cannot get the free space of {tempdir}: {e}')
            return max_procs
        fitting = free_mb // need_mb
        if fitting >= max_procs:
            return max_procs
        if fitting == 0:
            self.logger.error(
                f'{tempdir} has {free_mb} MB free, a duplicity backup needs {need_mb} MB'
                f' there and aborts with exit code 35. Free up space, or set TMPDIR in'
                f' the env of the config file to another dir.'
            )
            return 1
        # the backups take longer, but succeed, so nothing to act on
        self.logger.info(
            f'Throttled to {fitting} instead of {max_procs} backups at the same time:'
            f' {tempdir} has {free_mb} MB free, a duplicity backup needs {need_mb} MB there'
        )
        return fitting


    def do_backup(self):
        """Do a massive parallel backup using duplicity and swift as backend. After that, delete
           all backups older than the given retention time.
           This function works and is fast, but the code is not very good and could be improved later.
        """
        self.logger.info('Starting backup...')

        # count the number of logical processors to limit number of processes (code taken from psutil)
        cpu_count = min(os.sysconf('SC_NPROCESSORS_ONLN'), 6)
        env = self.set_env(self.config.get('env', {}))
        backup_procs = self.backup_procs_fitting_temp_dir(env, cpu_count + 1)
        backup_failed_retcs = []
        backup_failed_paths = set()
        cleanup_failed_retcs = []

        # iterate over backup dirs and spawn processes
        running_procs = []
        for src in self.config.get('backup_sources', []):
            if not os.path.exists(src.get('path')):
                # be tolerant. skip non-existing paths to prevent duplicity error 23
                continue

            if src.get('divide', False):
                # divide the source dir:
                # do not backup the whole dir, but every item on the first level individually
                self.logger.debug(f"Dividing the source dir {src.get('path')}")
                src['filelist'] = self.divide_source_dir(src.get('path'))
            else:
                src['filelist'] = [src.get('path')]

            for f in src['filelist']:
                cmd = self.build_duplicity_backup_command(f, src)
                self.logger.info(f"Running: {' '.join(cmd)}")

                self.run_cmd_in_background(
                    cmd, env, running_procs, backup_procs, backup_failed_retcs,
                    path=f, failed_paths=backup_failed_paths
                )

        # wait here for all processes to finish
        self.logger.debug('All duplicity processes started, waiting for them to finish.')
        self.wait_for_running_procs(running_procs, backup_failed_retcs, backup_failed_paths)

        self.logger.info('Backup done.')
        self.logger.info('Starting cleanup...')
        # Delete all backup sets older than the given time. Old backup sets will not be deleted if
        # backup sets newer than time depend on them. Note, this action cannot be combined with backup
        # or other actions, such as cleanup. Note also that --force will be needed to delete the files
        # instead of just listing them.

        # iterate over backup dirs and spawn processes
        running_procs = []
        for src in self.config.get('backup_sources', []):
            if not os.path.exists(src.get('path')):
                # be tolerant. skip non-existing paths to prevent duplicity error 23
                continue

            for f in src['filelist']:
                # Without a new backup, nothing replaces the backups the cleanup removes: a
                # path that keeps failing would lose every chain but its last one over time.
                if f in backup_failed_paths:
                    self.logger.warning(f'Skipping the cleanup of {f}, since its backup failed.')
                    continue
                cmd = self.build_duplicity_cleanup_command(f)
                self.logger.info(f"Running: {' '.join(cmd)}")

                self.run_cmd_in_background(
                    cmd, env, running_procs, cpu_count + 1, cleanup_failed_retcs
                )


        # wait here for all processes to finish
        self.logger.debug('All duplicity processes started, waiting for them to finish.')
        self.wait_for_running_procs(running_procs, cleanup_failed_retcs)

        self.logger.info('Cleanup done.')
        # a failed backup takes precedence over a failed cleanup
        sys.exit((backup_failed_retcs + cleanup_failed_retcs + [0])[0])


    def do_exec(self, duplicity_args):
        """Replace duba with duplicity, called with `duplicity_args` in the environment of the
           backup, so that the secrets never show up in the shell of the admin.
        """
        if not duplicity_args:
            self.logger.error('Nothing to run. Usage: duba exec -- <duplicity arguments>')
            sys.exit(210)
        # duplicity accepts options in front of the action
        cmd = ['duplicity'] + self.archive_dir_options() + duplicity_args
        env = self.set_env(self.config.get('env', {}))
        try:
            os.execvpe(cmd[0], cmd, env)
        except OSError as e:
            self.logger.error(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd[0]}"')
            sys.exit(205)


    def find_backup(self, path):
        """Return the source, the backup path (the local path duba passed to duplicity, which
           is also appended to the backup URL) and the path to restore inside that backup.
        """
        # the most specific source wins, e.g. /var/www/html/nextcloud/data over /var/www/html
        source = None
        for src in self.config.get('backup_sources', []):
            src_path = os.path.normpath(src.get('path'))
            if path != src_path and not path.startswith(src_path.rstrip('/') + '/'):
                continue
            if source is None or len(src_path) > len(os.path.normpath(source.get('path'))):
                source = src
        if source is None:
            self.logger.error(
                f'{path} is in none of the backup sources: '
                f"{', '.join(src.get('path') for src in self.config.get('backup_sources', []))}"
            )
            sys.exit(211)

        src_path = os.path.normpath(source.get('path'))
        rel_path = os.path.relpath(path, src_path) if path != src_path else ''
        if not source.get('divide', False):
            # build_duplicity_backup_command() appends the configured path as it is
            return source, source.get('path'), rel_path
        # a divided source has one backup per entry on its first level, see do_backup()
        if not rel_path:
            self.logger.error(
                f'{path} is divided into one backup per entry, restore the entries one by one'
            )
            sys.exit(212)
        entry, _, rest = rel_path.partition('/')
        return source, os.path.join(source.get('path'), entry), rest


    def warn_on_low_space(self, path, target):
        # Only a warning: the restore goes into its own directory, so running out of space
        # does not harm the live data. The local copy, if there still is one, is the only size
        # estimate there is, since the duplicity metadata does not hold the file sizes.
        if not os.path.lexists(path):
            return
        size = 0
        if os.path.isdir(path) and not os.path.islink(path):
            for root, _, files in os.walk(path):
                for name in files:
                    try:
                        size += os.lstat(os.path.join(root, name)).st_size
                    except OSError:
                        pass
        else:
            size = os.lstat(path).st_size
        stat = os.statvfs(target)
        free = stat.f_bavail * stat.f_frsize
        if free < size:
            self.logger.warning(
                f'{target} has {free // 2**20} MB free, the local copy of {path} has'
                f' {size // 2**20} MB'
            )


    def plan_restore(self, cmd, env):
        """Run `cmd`, a duplicity restore, with --dry-run and return the backup sets the
           restore reads, as {time of the set: number of volumes}, or None if duplicity
           cannot list them. Exits if duplicity fails, the restore would fail the same way.
        """
        # `restore --dry-run` lists the volumes since duplicity 2.0.0 (commit 790020b6)
        if self.duplicity_version < (2, 0, 0):
            self.logger.warning(
                f"duplicity {'.'.join(map(str, self.duplicity_version))} does not list the"
                f' volumes of a restore, so duba cannot tell the backup the state comes from'
                f' nor check the temp space'
            )
            return None
        # Even with --dry-run, duplicity creates the parent dirs of the local path, so it
        # gets a throwaway one instead of the real target. Verified with duplicity 3.2.2 on
        # Rocky 9.
        scratch_dir = tempfile.mkdtemp(prefix='duba-dry-run-')
        dry_run_cmd = cmd[:2] + ['--dry-run'] + cmd[2:-1] + [os.path.join(scratch_dir, 'x')]
        try:
            p = subprocess.run(
                dry_run_cmd,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
            )
        except OSError as e:
            self.logger.error(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd[0]}"')
            sys.exit(205)
        finally:
            shutil.rmtree(scratch_dir, ignore_errors=True)
        output = p.stdout.decode('utf-8', 'replace')
        if p.returncode != 0:
            print(output, end='', flush=True)
            if 'Bad time string' in output:
                self.logger.error(
                    'A time needs the seconds, e.g. --time=2026-10-01T12:00:00'
                )
            if p.returncode == 35:
                # check_resources(), see temp_space_mb()
                self.logger.error(
                    f'{self.temp_dir(env)} is too small for duplicity to start a restore.'
                    f' Set TMPDIR to a dir with enough space'
                )
            self.logger.error(f"Exit code {p.returncode}: {' '.join(dry_run_cmd)}")
            sys.exit(p.returncode)
        backup_sets = {}
        for match in VOLUME_REGEX.finditer(output):
            backup_sets[match.group('time')] = backup_sets.get(match.group('time'), 0) + 1
        if not backup_sets:
            self.logger.warning(
                'duplicity lists no volumes for the restore, so duba cannot tell the backup'
                ' the state comes from nor check the temp space'
            )
            return None
        return backup_sets


    def temp_space_mb(self, backup_sets):
        """Return the temp space in MB a restore from `backup_sets` needs at most.
        """
        # A restore reads all backup sets of the chain at the same time, the full and every
        # incremental up to the restore time, and keeps one volume of each in the temp dir
        # until it is read (collate_iters() in duplicity/patchdir.py,
        # restore_get_enc_fileobj() in duplicity/dup_main.py). Volumes are VOLSIZE_MB at
        # most, the last one of a set is usually smaller, so this is an upper bound.
        # Independently, duplicity aborts with exit code 35 on start if the temp dir has
        # less than 2 volumes plus 30% of one free, 1 before duplicity 3.0.1. Verified
        # against the duplicity source, rel.0.8.23 to rel.3.2.1 (check_resources()).
        start_volumes = 2 if self.duplicity_version >= (3, 0, 1) else 1
        start_mb = int((start_volumes + 0.3) * VOLSIZE_MB)
        if not backup_sets:
            return start_mb
        return max(start_mb, int(len(backup_sets) * VOLSIZE_MB * VOLUME_OVERHEAD))


    def format_backup_time(self, stamp):
        """Return the time of a backup set, '20260930T222203Z', in local time and in UTC.
        """
        epoch = calendar.timegm(time.strptime(stamp, '%Y%m%dT%H%M%SZ'))
        local = time.strftime('%Y-%m-%d %H:%M:%S %Z', time.localtime(epoch))
        utc = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(epoch))
        return f'{local} ({utc})'


    def do_restore(self, path, target=None, restore_time=None, dry_run=False,
                   ignore_space=False):
        """Restore `path` from the backup that holds it into `target`, below which `path` is
           recreated. duplicity refuses to restore into a directory that is not empty.
        """
        path = os.path.abspath(path)
        source, backup_path, path_to_restore = self.find_backup(path)
        # The restored files keep their owner and mode, but not the protection of the
        # parent directories they had on the host (e.g. /root), so the directories duba
        # creates are for root only. The default target gets a random name, any local
        # user could create a predictable one below /var/tmp in advance.
        os.umask(0o077)
        # the default target is created after the checks, so that an abort leaves nothing
        restore_path = os.path.join(
            os.path.abspath(target or '/var/tmp/duba-restore-<random>'), path.lstrip('/')
        )

        cmd = ['duplicity', 'restore']
        cmd += self.archive_dir_options()
        cmd += ['--backend-retry-delay', '60']
        cmd += ['--num-retries', '5']
        if path_to_restore:
            # renamed in duplicity 2.0.0
            if self.duplicity_version >= (2, 0, 0):
                cmd += ['--path-to-restore', path_to_restore]
            else:
                cmd += ['--file-to-restore', path_to_restore]
        if restore_time:
            cmd += ['--restore-time', restore_time]
        cmd += ['--verbosity', f"{self.config.get('loglevel', 'notice')}"]
        cmd += [f"{self.config.get('backup_dest')}{backup_path}"]
        cmd += [restore_path]

        env = self.set_env(self.config.get('env', {}))
        backup_sets = self.plan_restore(cmd, env)
        tempdir = self.temp_dir(env)
        need_mb = self.temp_space_mb(backup_sets)
        try:
            free_mb = self.free_mb(tempdir)
        except OSError as e:
            # duplicity reports this itself
            self.logger.warning(f'Cannot get the free space of {tempdir}: {e}')
            free_mb = None

        print(f"Source:          {source.get('path')}")
        print(f"Backup URL:      {self.config.get('backup_dest')}{backup_path}")
        print(f'Path to restore: {path_to_restore or "(the whole backup)"}')
        print(f'Restore to:      {restore_path}')
        if backup_sets:
            # duplicity only reads the sets whose volumes cover the path, so the newest of
            # them holds the restored state, even if later backups up to --time exist
            backup_time = self.format_backup_time(max(backup_sets))
            print(
                f'From backup:     {backup_time}, the newest of {len(backup_sets)} backup'
                f' set(s) read, {sum(backup_sets.values())} volume(s)'
            )
        print(
            f'Temp space:      up to {need_mb} MB in {tempdir},'
            f" {'free space unknown' if free_mb is None else f'{free_mb} MB free'}"
        )
        print(f"Command:         {' '.join(cmd)}", flush=True)

        if free_mb is not None and free_mb < need_mb:
            message = (
                f'{tempdir} has {free_mb} MB free, the restore needs up to {need_mb} MB'
                f' there. Set TMPDIR to a dir with enough space'
            )
            if dry_run or ignore_space:
                self.logger.warning(message)
            else:
                self.logger.error(f'{message}, or use --ignore-space')
                sys.exit(213)
        if dry_run:
            sys.exit(0)

        if not target:
            target = tempfile.mkdtemp(prefix='duba-restore-', dir='/var/tmp')
            restore_path = os.path.join(target, path.lstrip('/'))
            cmd[-1] = restore_path
        os.makedirs(os.path.dirname(restore_path), exist_ok=True)
        self.warn_on_low_space(path, os.path.dirname(restore_path))
        self.logger.info(f"Running: {' '.join(cmd)}")
        try:
            retc = subprocess.run(cmd, env=env).returncode
        except OSError as e:
            self.logger.error(f'OS Error "{e.errno} {e.strerror}" calling command "{cmd[0]}"')
            sys.exit(205)
        if retc == 0:
            if backup_sets:
                self.logger.info(
                    f'Restored {path} to {restore_path} from the backup of {backup_time}'
                )
            else:
                self.logger.info(f'Restored {path} to {restore_path}')
        sys.exit(retc)


def main():
    """The main function. Hier spielt die Musik.
    """

    # everything after the first `--` belongs to duplicity
    argv = sys.argv[1:]
    duplicity_args = []
    if '--' in argv:
        duplicity_args = argv[argv.index('--') + 1:]
        argv = argv[:argv.index('--')]

    # parse the command line, exit if it fails
    try:
        args = parse_args(argv)
    except SystemExit:
        sys.exit(221)

    if duplicity_args and args.COMMAND != 'exec':
        print('duba: arguments after `--` are only allowed with `exec`', file=sys.stderr)
        sys.exit(221)

    duba = Duba(args.CONFIG_FILE)
    if args.COMMAND == 'backup':
        duba.do_backup()
    elif args.COMMAND == 'exec':
        duba.do_exec(duplicity_args)
    elif args.COMMAND == 'restore':
        duba.do_restore(args.PATH, args.TARGET, args.TIME, args.DRY_RUN, args.IGNORE_SPACE)


if __name__ == '__main__':
    try:
        main()
    except Exception:   # pylint: disable=W0703
        print(format_exc().replace("<", "'").replace(">", "'"))
        sys.exit(222)

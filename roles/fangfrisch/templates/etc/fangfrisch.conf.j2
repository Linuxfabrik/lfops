# {{ ansible_managed }}
# 2026111201

[DEFAULT]
# Other sections inherit values from DEFAULT and may also overwrite values.
db_url = sqlite:////var/lib/fangfrisch/db.sqlite
local_directory = /var/lib/clamav
log_level = info
on_update_exec = clamdscan --reload
on_update_timeout = 42

[sanesecurity]
enabled = true

{% if fangfrisch__securiteinfo_customer_id is defined and fangfrisch__securiteinfo_customer_id | length > 0 %}
[securiteinfo]
enabled = true
customer_id = {{ fangfrisch__securiteinfo_customer_id }}

{% endif %}
{# abuse.ch only serves the URLhaus signatures with an auth key. Without one, Fangfrisch requests
   them with its placeholder key, and every refresh logs a 401 for this source. #}
{% if fangfrisch__urlhaus_auth_key is defined and fangfrisch__urlhaus_auth_key | length > 0 %}
[urlhaus]
enabled = true
auth_key = {{ fangfrisch__urlhaus_auth_key }}
{% endif %}

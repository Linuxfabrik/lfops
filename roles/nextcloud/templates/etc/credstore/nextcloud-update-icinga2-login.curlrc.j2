# {{ ansible_managed }}
# 2026110301

# Login of the Icinga2 downtime API user, stored as the systemd credential
# `nextcloud-update-icinga2-login.curlrc` (encrypted in /etc/credstore.encrypted/ with systemd
# 251 and newer, else in /etc/credstore/). nextcloud-update passes it to `curl --config`
# through a pipe, so that the login does not show up in the process list.

header = "Authorization: Basic {{ (nextcloud__icinga2_api_user_login['username'] ~ ':' ~ nextcloud__icinga2_api_user_login['password']) | b64encode }}"

# {{ ansible_managed }}
# 2026091302

# Settings that only take effect when PostgreSQL is restarted (context "postmaster" in
# pg_settings). Settings that a reload applies belong in z00-linuxfabrik-reload.conf, so that
# changing them does not restart the server.

#------------------------------------------------------------------------------
# CONNECTIONS AND AUTHENTICATION
#------------------------------------------------------------------------------

# - Connection Settings -

listen_addresses = '{{ postgresql_server__conf_listen_addresses | d(['localhost']) | join(',') }}'
port = {{ postgresql_server__conf_port | d(5432) }}
max_connections = {{ postgresql_server__conf_max_connections | d(100) }}

# {{ ansible_managed }}
# 2026100601

[copr:copr.fedorainfracloud.org:group_OpenVPN:openvpn-release-2.7]
name=Copr repo for openvpn-release-2.7 owned by @OpenVPN
{% if repo_openvpn__mirror_url is defined and repo_openvpn__mirror_url | length %}
baseurl={{ repo_openvpn__mirror_url }}/copr/OpenVPN/openvpn-release-2.7/epel-{{ ansible_facts["distribution_major_version"] }}-x86_64/
{% else %}
baseurl=https://download.copr.fedorainfracloud.org/results/@OpenVPN/openvpn-release-2.7/epel-{{ ansible_facts["distribution_major_version"] }}-$basearch/
{% endif %}
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-copr-OpenVPN-openvpn-release-2.7
repo_gpgcheck=0
enabled=1
enabled_metadata=1
{% if repo_openvpn__mirror_url is defined and repo_openvpn__mirror_url | length and repo_openvpn__basic_auth_login is defined and repo_openvpn__basic_auth_login | length %}
username={{ repo_openvpn__basic_auth_login["username"] }}
password={{ repo_openvpn__basic_auth_login["password"] }}
{% endif %}

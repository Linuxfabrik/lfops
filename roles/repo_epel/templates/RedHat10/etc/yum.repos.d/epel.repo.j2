# {{ ansible_managed }}
# 2026111301
{# Deviates from epel-release, which asks for `epel-$releasever${stream:+s}`: Rocky and
   RHEL set $releasever to 10, and for `epel-10` MirrorManager hands out the EPEL of the
   newest RHEL minor release, whose packages may need packages the host does not have
   yet. Rocky also sets $stream and would end up on `epel-10s`, which is built for
   CentOS Stream. $releasever_minor comes from the `system-release(releasever_minor)`
   provide of the release package (libdnf/dnf-context.cpp). CentOS Stream has none, so
   `${releasever_minor:+.}${releasever_minor:-s}` gives `.2` on Rocky 10.2 and `s` on
   CentOS Stream.
   Verified against dnf 4.20 and libdnf 0.73 on Rocky 10.2, UBI 10.3 and CentOS Stream 10. #}

# EPEL 10 has one repository per RHEL minor release, plus one for CentOS Stream.
# Unless a mirror is configured, the repositories below follow the minor release of
# this host, and on CentOS Stream they point to the one for CentOS Stream.

[epel]
name=Extra Packages for Enterprise Linux $releasever - $basearch
# It is much more secure to use the metalink, but if you wish to use a local mirror
# place its address here.
{% if repo_epel__mirror_url is defined and repo_epel__mirror_url | length %}
baseurl={{ repo_epel__mirror_url }}/epel/10/Everything/x86_64
#metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-$releasever&arch=$basearch&infra=$infra&content=$contentdir
{% else %}
#baseurl=https://download.example/pub/epel/$releasever_major${releasever_minor:+.}${releasever_minor:-s}/Everything/$basearch/
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-$releasever_major${releasever_minor:+.}${releasever_minor:-s}&arch=$basearch
{% endif %}
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-$releasever_major
gpgcheck=1
repo_gpgcheck=0
metadata_expire=24h
countme=1
enabled=1
{% if repo_epel__mirror_url is defined and repo_epel__mirror_url | length and repo_epel__basic_auth_login is defined and repo_epel__basic_auth_login | length %}
username={{ repo_epel__basic_auth_login["username"] }}
password={{ repo_epel__basic_auth_login["password"] }}
{% endif %}


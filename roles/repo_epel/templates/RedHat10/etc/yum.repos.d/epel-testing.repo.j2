# {{ ansible_managed }}
# 2026111201
{# Deviates from epel-release, which asks for `epel-$releasever`: Rocky and RHEL set
   $releasever to 10, and for that MirrorManager hands out the newest minor release of
   EPEL, whose packages may need a RHEL minor release the host does not have yet.
   $releasever_minor comes from the `system-release(releasever_minor)` provide of the
   release package (libdnf/dnf-context.cpp). CentOS Stream has none and keeps `epel-10`.
   Verified against dnf 4.20 and libdnf 0.73 on Rocky 10.2, UBI 10.2 and CentOS Stream 10. #}

# EPEL 10 has one repository per RHEL minor release. Unless a mirror is configured,
# the repositories below follow the minor release of this host.

[epel-testing]
name=Extra Packages for Enterprise Linux $releasever - Testing - $basearch
# It is much more secure to use the metalink, but if you wish to use a local mirror
# place its address here.
{% if repo_epel__mirror_url is defined and repo_epel__mirror_url | length %}
baseurl={{ repo_epel__mirror_url }}/epel/testing/10/Everything/x86_64
#metalink=https://mirrors.fedoraproject.org/metalink?repo=testing-epel$releasever&arch=$basearch&infra=$infra&content=$contentdir
{% else %}
#baseurl=https://download.example/pub/epel/testing/$releasever_major${releasever_minor:+.$releasever_minor}/Everything/$basearch/
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-testing-$releasever_major${releasever_minor:+.$releasever_minor}&arch=$basearch
{% endif %}
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-$releasever_major
gpgcheck=1
repo_gpgcheck=0
metadata_expire=24h
countme=1
enabled=0
{% if repo_epel__mirror_url is defined and repo_epel__mirror_url | length and repo_epel__basic_auth_login is defined and repo_epel__basic_auth_login | length %}
username={{ repo_epel__basic_auth_login["username"] }}
password={{ repo_epel__basic_auth_login["password"] }}
{% endif %}


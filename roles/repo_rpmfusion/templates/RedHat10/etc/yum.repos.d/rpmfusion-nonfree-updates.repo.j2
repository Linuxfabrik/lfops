# {{ ansible_managed }}
# 2026112001

[rpmfusion-nonfree-updates]
name=RPM Fusion for EL 10 - Nonfree - Updates
{% if repo_rpmfusion__mirror_url is defined and repo_rpmfusion__mirror_url | length %}
baseurl={{ repo_rpmfusion__mirror_url }}/rpmfusion/nonfree-el-updates-released-10/x86_64
#metalink=http://mirrors.rpmfusion.org/metalink?repo=nonfree-el-updates-released-10&arch=$basearch
{% else %}
#baseurl=http://download1.rpmfusion.org/nonfree/el/updates/10/$basearch/
metalink=http://mirrors.rpmfusion.org/metalink?repo=nonfree-el-updates-released-10&arch=$basearch
{% endif %}
enabled=1
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-nonfree-el-10
{% if repo_rpmfusion__mirror_url is defined and repo_rpmfusion__mirror_url | length and repo_rpmfusion__basic_auth_login is defined and repo_rpmfusion__basic_auth_login | length %}
username={{ repo_rpmfusion__basic_auth_login["username"] }}
password={{ repo_rpmfusion__basic_auth_login["password"] }}
{% endif %}

